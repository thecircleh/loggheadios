workflows:
  loggerhead-ios:
    name: Loggerhead iOS - TestFlight
    max_build_duration: 60
    instance_type: mac_mini_m1

    integrations:
      app_store_connect: Loggerhead ASC Key

    environment:
      ios_signing:
        distribution_type: app_store
        bundle_identifier: com.loggerheadstat.app
      vars:
        XCODE_PROJECT: "App.xcodeproj"
        XCODE_SCHEME: "App"
        BUNDLE_ID: "com.loggerheadstat.app"
        REACT_APP_API_URL: "https://api.loggerhead.app"
      node: v22.0.0

    scripts:
      - name: Install npm dependencies
        script: |
          cd $CM_BUILD_DIR
          npm install

      - name: Build React app
        script: |
          cd $CM_BUILD_DIR
          REACT_APP_API_URL=$REACT_APP_API_URL npm run build

      - name: Add iOS platform
        script: |
          cd $CM_BUILD_DIR
          rm -rf ios
          npx cap add ios

      - name: Copy web assets to iOS
        script: |
          cd $CM_BUILD_DIR
          npx cap copy ios

      - name: Set up keychain and signing
        script: |
          keychain initialize
          app-store-connect fetch-signing-files $BUNDLE_ID \
            --type IOS_APP_STORE \
            --create
          keychain add-certificates
          xcode-project use-profiles

      - name: Create export options plist
        script: |
          PROFILE_UUID=$(xcode-project use-profiles --profile-uuid-variable PROFILE_UUID 2>/dev/null || echo "")
          cat > /Users/builder/export_options.plist << PLIST
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
            <key>method</key>
            <string>app-store</string>
            <key>teamID</key>
            <string>46W6UT654D</string>
            <key>uploadBitcode</key>
            <false/>
            <key>uploadSymbols</key>
            <true/>
            <key>signingStyle</key>
            <string>manual</string>
            <key>provisioningProfiles</key>
            <dict>
              <key>com.loggerheadstat.app</key>
              <string>Loggerhead App Store</string>
            </dict>
          </dict>
          </plist>
          PLIST

      - name: Build and archive iOS app
        script: |
          cd $CM_BUILD_DIR/ios/App
          xcodebuild \
            -project "$XCODE_PROJECT" \
            -scheme "$XCODE_SCHEME" \
            -configuration Release \
            -archivePath build/App.xcarchive \
            CODE_SIGN_STYLE=Manual \
            DEVELOPMENT_TEAM=46W6UT654D \
            PROVISIONING_PROFILE_SPECIFIER="Loggerhead App Store" \
            archive
          xcodebuild \
            -exportArchive \
            -archivePath build/App.xcarchive \
            -exportOptionsPlist /Users/builder/export_options.plist \
            -exportPath build/ios/ipa

    artifacts:
      - $CM_BUILD_DIR/ios/App/build/ios/ipa/*.ipa
      - /tmp/xcodebuild_logs/*.log

    publishing:
      app_store_connect:
        auth: integration
        submit_to_testflight: true
        beta_groups:
          - "Internal Testers"