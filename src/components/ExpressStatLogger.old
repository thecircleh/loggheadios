      />

      {/* Players */}
      <div style={playersGridStyle}>
        {Array.isArray(courtPlayers) && courtPlayers.map((player, index) => {
          const isActive = isPlayerActive(index);
          const actionGroups = getAvailableActions(index);
          const isServerPosition = isCurrentServerSlot(index);
          const shouldHighlightServer = ballState === "serve" && currentServeSide === "our" && isServerPosition;
          const trackingStatus = getTrackingStatus(player._id); 
          return (
            <DroppableSlot key={index} index={index}>
              <DraggablePlayerCard player={player} index={index}>
                <div style={{
                  ...playerCardStyle(isActive),
                  borderColor: shouldHighlightServer ? '#FFD700' : (isActive ? '#007AFF' : 'transparent'),
                  borderWidth: shouldHighlightServer ? '3px' : '2px',
                  backgroundColor: shouldHighlightServer ? '#FFF9E6' : '#ffffff',
                  position: 'relative', 
                  opacity: (collaborativeMode && trackingStatus?.isAssigned && !trackingStatus?.isMe) ? 0.6 : 1
                }}>
                  
				   {collaborativeMode && player._id && (
            <PlayerTrackingIndicator 
              playerId={player._id} 
              playerName={player.name} 
            />
          )}
		  {collaborativeMode && trackingStatus?.isAssigned && !trackingStatus?.isMe && (
            <div style={{
              position: 'absolute',
