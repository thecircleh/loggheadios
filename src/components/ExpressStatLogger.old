    flexShrink: 0
  };

  const actionButtonsStyle = {
    display: 'flex',
    flexWrap: 'wrap',
    gap: '4px',
    flex: 1,
    justifyContent: 'flex-start',
    alignItems: 'center'
  };

  const actionButtonStyle = (variant = 'primary') => ({
    padding: '4px 8px',
    borderRadius: '4px',
    border: 'none',
    fontWeight: '600',
