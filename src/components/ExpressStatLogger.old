    marginLeft: '2px',
    minHeight: '30px',
    border: 'none',
    cursor: 'pointer',
    transition: 'all 0.15s ease',
    transform: 'scale(1)',
    boxShadow: '0 1px 2px rgba(0,0,0,0.1)'
  });

  const playersGridStyle = {
    display: 'flex',
    flexDirection: 'column',
    gap: '6px',
    marginBottom: '12px'
  };

  const playerCardStyle = (isActive) => ({
