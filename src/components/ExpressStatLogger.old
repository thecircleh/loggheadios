                          onClick={(e) => {
                            e.stopPropagation();
                            togglePlayerActivation(index);
                          }}
                          onMouseDown={(e) => {
                            e.target.style.transform = 'scale(0.95)';
                            e.target.style.opacity = '0.8';
                          }}
                          onMouseUp={(e) => {
                            e.target.style.transform = 'scale(1)';
                            e.target.style.opacity = '1';
                          }}
                          onMouseLeave={(e) => {
                            e.target.style.transform = 'scale(1)';
                            e.target.style.opacity = '1';
                          }}
                          style={{
                            padding: '2px 4px',
                            borderRadius: '3px',
                            border: 'none',
                            fontSize: '8px',
                            backgroundColor: isActive ? '#dc3545' : '#28a745',
                            color: '#ffffff',
                            cursor: 'pointer',
                            minWidth: '25px',
                            minHeight: '25px',
                            transition: 'all 0.15s ease',
                            transform: 'scale(1)'
                          }}
                        >
                          {isActive ? 'OFF' : 'ON'}
                        </button>
                      </div>
                    )}
                  </div>

                  {/* Action Buttons */}
                  {isActive && actionGroups.length > 0 && (
                    <div style={actionButtonsStyle}>
                      {actionGroups.map((group, groupIndex) => (
                        <React.Fragment key={group.category}>
                          <div style={{
                            fontSize: '8px',
                            color: '#666',
                            fontWeight: '600',
                            textTransform: 'uppercase',
                            transform: 'rotate(270deg)',
                            padding: '0px 0px',
                            alignSelf: 'flex-start',
                            marginTop: '10px'
                          }}>
                            {group.category}
                          </div>
                          
                          {group.actions.map(action => (
                            <button
                              key={action.key}
                              onClick={() => handlePlayerAction(index, action.key)}
                              onMouseDown={(e) => {
                                e.target.style.transform = 'scale(0.95)';
                                e.target.style.opacity = '0.8';
                              }}
                              onMouseUp={(e) => {
                                e.target.style.transform = 'scale(1)';
                                e.target.style.opacity = '1';
                              }}
                              onMouseLeave={(e) => {
                                e.target.style.transform = 'scale(1)';
                                e.target.style.opacity = '1';
                              }}
                              onMouseEnter={(e) => {
                                e.target.style.opacity = '0.9';
                              }}
                              style={actionButtonStyle(action.variant)}
                            >
                              {action.label}
                            </button>
                          ))}
                          
                          {groupIndex < actionGroups.length - 1 && (
                            <div style={{
                              width: '0px',
                              height: '30px',
                              backgroundColor: '#dee2e6',
                              margin: '0 4px',
                              alignSelf: 'center',
                            }} />
                          )}
                        </React.Fragment>
                      ))}
                    </div>
                  )}
                  
                  {isActive && actionGroups.length === 0 && (
                    <div style={{
                      flex: 1,
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      color: '#999',
                      fontStyle: 'italic',
                      fontSize: '10px',
                      padding: '4px'
                    }}>
                      {ballState === "serve" && currentServeSide === "our" && !isCurrentServerSlot(index) ? 
                        "Only server can act. NOT TRACKING THE SERVER? change the State to RALLY or manually change the score below." : 
                        "No actions available"
                      }
                    </div>
                  )}
                  
                  {!isActive && (
                    <div style={{ flex: 1 }} />
                  )}
                </div>
              </DraggablePlayerCard>
            </DroppableSlot>
          );
        })}
      </div>

      {/* NEW: Manual Position Control Section (Subdued) */}
      <div style={manualControlStyle}>
        <div style={{
          display: 'flex',
          flexDirection: 'column',
          gap: '6px',
          alignItems: 'center'
        }}>
          <div style={{
            fontSize: '12px',
            fontWeight: '500',
            color: '#6c757d',
            textAlign: 'center'
          }}>
            Manual Position Control
          </div>
          
          <button
            onClick={handleExpressRotation}
            onMouseDown={(e) => {
              e.target.style.transform = 'scale(0.97)';
              e.target.style.backgroundColor = '#e9ecef';
            }}
            onMouseUp={(e) => {
              e.target.style.transform = 'scale(1)';
              e.target.style.backgroundColor = '#f8f9fa';
            }}
            onMouseLeave={(e) => {
              e.target.style.transform = 'scale(1)';
              e.target.style.backgroundColor = '#f8f9fa';
            }}
            style={rotateButtonStyle}
          >
            Rotate Positions
          </button>
        </div>
      </div>

      {/* Block Assist Mode Controls */}
      {blockAssistMode && (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          backgroundColor: 'rgba(0,0,0,0.7)',
          display: 'flex',
          justifyContent: 'center',
          alignItems: 'center',
          zIndex: 9998
        }}>
          <div style={{
            backgroundColor: '#ffffff',
            borderRadius: '12px',
            padding: '20px',
            maxWidth: '500px',
            width: '95%',
            maxHeight: '80vh',
            overflow: 'auto',
            boxShadow: '0 4px 12px rgba(0,0,0,0.15)'
          }}>
            <h3 style={{ 
              marginTop: 0, 
              marginBottom: '16px',
              fontSize: '18px',
              color: '#333',
              textAlign: 'center'
            }}>
              Block Assist
            </h3>
            
            <p style={{
              fontSize: '14px',
              color: '#666',
              textAlign: 'center',
              marginBottom: '16px'
            }}>
              Click on the front row players who participated in the block assist.
            </p>

            {/* Front Row Players Selection */}
            <div style={{
              marginBottom: '16px',
              padding: '12px',
              backgroundColor: '#f8f9fa',
              borderRadius: '8px'
            }}>
              <div style={{ fontSize: '12px', fontWeight: '600', color: '#333', marginBottom: '12px' }}>
                Front Row Players (Positions 2, 3, 4):
              </div>
              
              <div style={{
                display: 'flex',
                flexDirection: 'column',
                gap: '8px'
              }}>
                {courtPlayers.map((player, index) => {
                  const currentPosition = getVolleyballPosition(index);
                  const isActive = isPlayerActive(index);
                  const isSelected = selectedBlockPlayers.has(index);
                  
                  // Only show front row players (positions 2, 3, 4) who are active and not liberos
                  if (!isActive || !player || !player.name || player.name === "?" || 
                      (currentPosition !== '2' && currentPosition !== '3' && currentPosition !== '4') ||
                      player.isLibero) {
                    return null;
                  }
                  
                  return (
                    <div
                      key={index}
                      onClick={() => handleBlockAssistSelection(index)}
                      style={{
                        padding: '12px',
                        borderRadius: '8px',
                        border: `2px solid ${isSelected ? '#28a745' : '#dee2e6'}`,
                        backgroundColor: isSelected ? '#e8f5e8' : '#ffffff',
                        cursor: 'pointer',
                        transition: 'all 0.2s ease',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'space-between'
                      }}
                      onMouseOver={(e) => {
                        if (!isSelected) {
                          e.target.style.backgroundColor = '#f8f9fa';
                          e.target.style.borderColor = '#007AFF';
                        }
                      }}
                      onMouseOut={(e) => {
                        if (!isSelected) {
                          e.target.style.backgroundColor = '#ffffff';
                          e.target.style.borderColor = '#dee2e6';
                        }
                      }}
                    >
                      <div>
                        <div style={{ 
                          fontWeight: '600', 
                          fontSize: '14px',
                          color: '#333'
                        }}>
						{player.name}
                        </div>
                        <div style={{ 
                          fontSize: '12px', 
                          color: '#666' 
                        }}>
                          #{player.number} • Position {currentPosition}
                        </div>
                      </div>
                      
                      <div style={{
                        padding: '4px 8px',
                        borderRadius: '4px',
                        fontSize: '12px',
                        fontWeight: '600',
                        backgroundColor: isSelected ? '#28a745' : '#6c757d',
                        color: '#ffffff'
                      }}>
                        {isSelected ? 'SELECTED' : 'SELECT'}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
            
            {/* Selected Players Summary */}
            <div style={{
              marginBottom: '16px',
              padding: '12px',
              backgroundColor: '#e8f5e8',
              borderRadius: '8px',
              border: '1px solid #28a745'
            }}>
              <div style={{ fontSize: '12px', fontWeight: '600', color: '#333', marginBottom: '8px' }}>
                Selected Players ({selectedBlockPlayers.size}):
              </div>
              {selectedBlockPlayers.size > 0 ? (
                <div style={{ fontSize: '14px', color: '#155724' }}>
                  {Array.from(selectedBlockPlayers).map(playerIndex => {
                    const player = courtPlayers[playerIndex];
                    return player ? `${player.name} (#${player.number})` : '';
                  }).filter(Boolean).join(', ')}
                </div>
              ) : (
                <div style={{ fontSize: '14px', color: '#999', fontStyle: 'italic' }}>
                  No players selected yet
                </div>
              )}
            </div>
            
            {/* Action Buttons */}
            <div style={{
              display: 'flex',
              gap: '12px',
              justifyContent: 'center'
            }}>
              <button
                onClick={submitBlockAssist}
                disabled={selectedBlockPlayers.size === 0}
                style={{
                  padding: '12px 24px',
                  borderRadius: '8px',
                  border: 'none',
                  backgroundColor: selectedBlockPlayers.size > 0 ? '#28a745' : '#6c757d',
                  color: '#ffffff',
                  fontWeight: '600',
                  fontSize: '14px',
                  cursor: selectedBlockPlayers.size > 0 ? 'pointer' : 'not-allowed',
                  transition: 'all 0.15s ease'
                }}
              >
                Submit Block Assist ({selectedBlockPlayers.size})
              </button>
              
              <button
                onClick={cancelBlockAssist}
                style={{
                  padding: '12px 24px',
                  borderRadius: '8px',
                  border: 'none',
                  backgroundColor: '#dc3545',
                  color: '#ffffff',
                  fontWeight: '600',
                  fontSize: '14px',
                  cursor: 'pointer',
                  transition: 'all 0.15s ease'
                }}
              >
                Cancel
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Assist Mode Modal */}
      {assistMode && selectedAssistPlayer !== null && (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          backgroundColor: 'rgba(0,0,0,0.7)',
          display: 'flex',
          justifyContent: 'center',
          alignItems: 'center',
          zIndex: 9998
        }}>
          <div style={{
            backgroundColor: '#ffffff',
            borderRadius: '12px',
            padding: '20px',
            maxWidth: '500px',
            width: '95%',
            maxHeight: '80vh',
            overflow: 'auto',
            boxShadow: '0 4px 12px rgba(0,0,0,0.15)'
          }}>
            <h3 style={{ 
              marginTop: 0, 
              marginBottom: '16px',
              fontSize: '18px',
              color: '#333',
              textAlign: 'center'
            }}>
              Who got the kill?
            </h3>
            
            <div style={{
              marginBottom: '16px',
              padding: '12px',
              backgroundColor: '#e8f5e8',
              borderRadius: '8px',
              border: '1px solid #28a745'
            }}>
              <div style={{ fontSize: '14px', color: '#155724', textAlign: 'center' }}>
                <strong>Assisting Player:</strong> {courtPlayers[selectedAssistPlayer]?.name} (#{courtPlayers[selectedAssistPlayer]?.number})
              </div>
            </div>
            
            <p style={{
              fontSize: '14px',
              color: '#666',
              textAlign: 'center',
              marginBottom: '16px'
            }}>
              Select the player who got the kill from this assist.
            </p>

            {/* Other Players Selection */}
            <div style={{
              marginBottom: '16px',
              padding: '12px',
              backgroundColor: '#f8f9fa',
              borderRadius: '8px'
            }}>
              <div style={{ fontSize: '12px', fontWeight: '600', color: '#333', marginBottom: '12px' }}>
                Available Players:
              </div>
              
              <div style={{
                display: 'flex',
                flexDirection: 'column',
                gap: '8px'
              }}>
                {courtPlayers
                  .map((player, index) => ({ player, index }))
                  .filter(({ player, index }) => {
                    return player && 
                           player.name !== "?" && 
                           player._id && 
                           isPlayerActive(index) && 
                           index !== selectedAssistPlayer;
                  })
                  .sort((a, b) => (a.player.number || 999) - (b.player.number || 999)) // Sort by number
                  .map(({ player, index }) => (
                    <div
                      key={index}
                      onClick={() => handleAssistSelection(selectedAssistPlayer, index)}
                      style={{
                        padding: '12px',
                        borderRadius: '8px',
                        border: '2px solid #dee2e6',
                        backgroundColor: '#ffffff',
                        cursor: 'pointer',
                        transition: 'all 0.2s ease',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'space-between'
                      }}
                      onMouseOver={(e) => {
                        e.target.style.backgroundColor = '#f8f9fa';
                        e.target.style.borderColor = '#007AFF';
                      }}
                      onMouseOut={(e) => {
                        e.target.style.backgroundColor = '#ffffff';
                        e.target.style.borderColor = '#dee2e6';
                      }}
                    >
                      <div>
                        <div style={{ 
                          fontWeight: '600', 
                          fontSize: '14px',
                          color: '#333'
                        }}>
                          {player.name}
                        </div>
                        <div style={{ 
                          fontSize: '12px', 
                          color: '#666' 
                        }}>
                          #{player.number} • Position {getVolleyballPosition(index)}
                        </div>
                      </div>
                      
                      <div style={{
                        padding: '4px 8px',
                        borderRadius: '4px',
                        fontSize: '12px',
                        fontWeight: '600',
                        backgroundColor: '#28a745',
                        color: '#ffffff'
                      }}>
                        SELECT
                      </div>
                    </div>
                  ))}
              </div>
            </div>
            
{/* Action Buttons */}
            <div style={{
  display: 'flex',
  gap: '12px',
  justifyContent: 'center'
}}>
  <button
    onClick={ignoreKill}
    style={{
      padding: '12px 24px',
      borderRadius: '8px',
      border: 'none',
      backgroundColor: '#ffc107',
      color: '#212529',
      fontWeight: '600',
      fontSize: '14px',
      cursor: 'pointer',
      transition: 'all 0.15s ease'
    }}
  >
    Ignore Kill
  </button>
              <button
                onClick={cancelAssist}
                style={{
                  padding: '12px 24px',
                  borderRadius: '8px',
                  border: 'none',
                  backgroundColor: '#dc3545',
                  color: '#ffffff',
                  fontWeight: '600',
                  fontSize: '14px',
                  cursor: 'pointer',
                  transition: 'all 0.15s ease'
                }}
              >
                Cancel
              </button>
            </div>
          </div>
        </div>
      )}

      {/* NEW: Sticky Bottom Bar for Critical Scoring Actions */}
      <div style={stickyBottomBarStyle}>
        <div style={bottomBarContentStyle}>
          {/* Our Team Gets Point Section */}
          <div style={bottomBarSectionStyle}>
            <div style={bottomBarLabelStyle}>
              Our Team Gets Point
            </div>
            
            <div style={bottomBarButtonRowStyle}>
              <button
                onClick={() => handlePointAwarded('ourEarned')}
                disabled={collaborativeMode && !isConnected}
                style={{
                  ...bottomBarButtonStyle('#28a745'),
                  opacity: (collaborativeMode && !isConnected) ? 0.5 : 1
                }}
              >
                We Earned
              </button>
              
               <button
                onClick={() => handlePointAwarded('opponentError')}
                disabled={collaborativeMode && !isConnected}
                style={{
                  ...bottomBarButtonStyle('#ffc107', '#212529'),
                  opacity: (collaborativeMode && !isConnected) ? 0.5 : 1
                }}
              >
                Opp Error
              </button>
            </div>
          </div>

          {/* Opponent Gets Point Section */}

            
            <div style={bottomBarSectionStyle}>
            <div style={bottomBarLabelStyle}>
              Opponent Gets Point
            </div>
            
            <div style={bottomBarButtonRowStyle}>
              <button
                onClick={() => handlePointAwarded('opponentEarned')}
                disabled={collaborativeMode && !isConnected}
                style={{
                  ...bottomBarButtonStyle('#dc3545'),
                  opacity: (collaborativeMode && !isConnected) ? 0.5 : 1
                }}
              >
                They Earned
              </button>
              
              <button
                onClick={() => handlePointAwarded('ourError')}
                disabled={collaborativeMode && !isConnected}
                style={{
                  ...bottomBarButtonStyle('#fd7e14'),
                  opacity: (collaborativeMode && !isConnected) ? 0.5 : 1
                }}
              >
                Our Error
              </button>
            </div>
          </div>
        </div>
      </div>
  


      {/* Roster Selection Modal */}
      {showRosterModal && (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          backgroundColor: 'rgba(0,0,0,0.5)',
          display: 'flex',
          justifyContent: 'center',
          alignItems: 'center',
          zIndex: 9999
        }}>
          <div style={{
            backgroundColor: '#ffffff',
            borderRadius: '12px',
            padding: '16px',
            maxWidth: '500px',
            width: '95%',
            maxHeight: '80vh',
            overflow: 'auto'
          }}>
            <h3 style={{ marginTop: 0, fontSize: '18px' }}>
              Select Player for Position {selectedSlot !== null ? getVolleyballPosition(selectedSlot) : ''}
              {selectedSlot !== null && isCurrentServerSlot(selectedSlot) ? ' (Server)' : ''}
            </h3>
            
            <div style={{
              display: 'grid',
              gridTemplateColumns: 'repeat(auto-fill, minmax(180px, 1fr))',
              gap: '8px',
              marginBottom: '12px'
            }}>
              {availableRoster
                .filter(player => {
                  const currentSlotPlayer = selectedSlot !== null ? courtPlayers[selectedSlot] : null;
                  return !courtPlayers.some((assignedPlayer, index) => 
                    assignedPlayer && assignedPlayer._id === player._id && index !== selectedSlot
                  );
                })
                .map(player => (
                <button
                  key={player._id}
                  onClick={() => selectPlayer(player)}
                  style={{
                    padding: '10px',
                    borderRadius: '8px',
                    border: '1px solid #dee2e6',
                    backgroundColor: '#ffffff',
                    cursor: 'pointer',
                    textAlign: 'left',
                    transition: 'all 0.2s ease',
                    fontSize: '14px'
                  }}
                  onMouseOver={(e) => {
                    e.target.style.backgroundColor = '#f8f9fa';
                  }}
                  onMouseOut={(e) => {
                    e.target.style.backgroundColor = '#ffffff';
                  }}
                >
                  <div style={{ fontWeight: '600' }}>{player.name}</div>
                  <div style={{ fontSize: '12px', color: '#666' }}>
                    #{player.number} {player.isLibero ? '(Libero)' : ''}
                  </div>
                </button>
              ))}
            </div>
            
            <button
              onClick={() => setShowRosterModal(false)}
              onMouseDown={(e) => {
                e.target.style.transform = 'scale(0.97)';
                e.target.style.opacity = '0.8';
              }}
              onMouseUp={(e) => {
                e.target.style.transform = 'scale(1)';
                e.target.style.opacity = '1';
              }}
              onMouseLeave={(e) => {
                e.target.style.transform = 'scale(1)';
                e.target.style.opacity = '1';
              }}
              style={{
                padding: '8px 16px',
                borderRadius: '6px',
                border: 'none',
                backgroundColor: '#6c757d',
                color: '#ffffff',
                cursor: 'pointer',
                fontSize: '14px',
                transition: 'all 0.15s ease',
                transform: 'scale(1)'
              }}
            >
              Cancel
            </button>
          </div>
        </div>
      )}
    </div>
  );
};

export default ExpressStatLogger;