.ios-card {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  border-radius: 15px;
  padding: 20px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  text-align: center;
  width: 90%;
  max-width: 500px;
  margin: auto;
}

.ios-header {
  font-size: 1.4rem;
  font-weight: bold;
  color: #333;
  margin-bottom: 10px;
}

.ios-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
  gap: 10px;
  justify-content: center;
  margin-bottom: 15px;
}

.ios-button-group {
  display: flex;
  gap: 10px;
  justify-content: center;
  margin-bottom: 15px;
}

.ios-button {
  padding: 10px 15px;
  border: none;
  border-radius: 10px;
  font-size: 1rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.ios-button.red { background: #ff3b30; color: white; }
.ios-button.blue { background: #007aff; color: white; }
.ios-button.green { background: #34c759; color: white; }

.ios-form {
  display: flex;
  gap: 10px;
  justify-content: center;
}

.ios-form input {
  padding: 8px;
  border: 1px solid #ccc;
  border-radius: 8px;
}

.ios-court {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(10px);
  border-radius: 15px;
  padding: 10px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}