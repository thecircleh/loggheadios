    gap: 6,
    boxShadow: "0 2px 6px rgba(0,0,0,0.06)",
  },
  playerName: {
    fontWeight: 600,
    fontSize: 14,
  },
  playerNumber: {
    color: "#666",
    fontSize: 13,
  },
  drillList: {
    display: "grid",
    gap: 12,
  },
  drillCard: {
    background: "#fff",
    borderRadius: 16,
    padding: 16,
    boxShadow: "0 4px 12px rgba(0,0,0,0.08)",
  },
  drillHeader: {
    display: "flex",
    gap: 12,
    marginBottom: 8,
  },
  drillNumber: {
    width: 32,
    height: 32,
    borderRadius: 16,
    background: "#007AFF",
    color: "#fff",
    display: "flex",
    alignItems: "center",
    justifyContent: "center",
    fontWeight: 700,
    flexShrink: 0,
  },
