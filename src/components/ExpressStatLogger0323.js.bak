}, []);

// FIXED: Enhanced socket error handling


const setBallStateWithSync = useCallback((newBallState) => {
  console.log('🎯 setBallStateWithSync called:', {
    newBallState,
    collaborativeMode,
    isConnected
  });
  
  // ALWAYS update local state immediately for responsive UX
  setBallState(newBallState);
  
  // Set a brief local override to prevent incoming collaborative changes from overriding our immediate change
  setLocalStateOverride({
    ballState: newBallState,
    timestamp: Date.now()
  });
  
  // Clear the override after a short delay
  if (localStateTimeoutRef.current) {
    clearTimeout(localStateTimeoutRef.current);
  }
  localStateTimeoutRef.current = setTimeout(() => {
    setLocalStateOverride(null);
  }, 500); // ✅ Reduced from 1000ms to 500ms for faster sync
  
  // THEN send collaborative update to other users
  if (collaborativeMode && isConnected) {
    console.log('📤 Sending ball state update to other users');
    const syncSuccess = updateCollaborativeBallState(newBallState, {
      ballSide: ballSide,
      currentServeSide: currentServeSide
    });
    
    if (!syncSuccess) {
      console.warn('Failed to send collaborative ball state update to other users');
      showActionToast('Failed to sync state change', 'error');
    } else {
      console.log('✅ Ball state update sent successfully');
    }
  }
}, [
  setBallState,
  collaborativeMode, 
  isConnected, 
  updateCollaborativeBallState,
  ballSide, 
  currentServeSide,
  showActionToast
]);




