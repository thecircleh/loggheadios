const withTimeout = (p, ms, label = 'operation') =>
  Promise.race([
    p,
    new Promise((_, rej) => setTimeout(() => rej(new Error(`${label} timed out after ${ms}ms`)), ms))
  ]);

const sleep = (ms) => new Promise(res => setTimeout(res, ms));
