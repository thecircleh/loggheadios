  // Only disable if collaborative mode is on AND we explicitly can't score
  backgroundColor: (collaborativeMode && !isConnected && !isCollaborativeReady()) ? '#6c757d' : backgroundColor,
  color: textColor,
  fontWeight: '600',
  fontSize: '12px',
