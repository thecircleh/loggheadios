            const bIsOn = playerOnOffStatus[b._id] || false;
            if (aIsOn && !bIsOn) return -1;
            if (!aIsOn && bIsOn) return 1;
            return 0; // Keep original order within ON or OFF groups
          }).map(player => {
            const isOn = playerOnOffStatus[player._id] || false;
       
            
