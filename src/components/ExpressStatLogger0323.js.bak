        {myAssignments.length > 0 ? (
          <div style={{
            display: 'flex',
            flexWrap: 'wrap',
            gap: '6px',
            justifyContent: 'center',
            marginBottom: '8px'
          }}>
            {myAssignments.map(assignment => (
              <div
                key={assignment.playerId}
                style={{
                  padding: '4px 8px',
                  backgroundColor: '#28a745',
                  color: '#fff',
                  borderRadius: '12px',
                  fontSize: '11px',
                  fontWeight: '600'
                }}
              >
                {assignment.playerName}
              </div>
            ))}
          </div>
        ) : (
          <div style={{
            fontSize: '11px',
            color: '#999',
            textAlign: 'center',
            fontStyle: 'italic',
            marginBottom: '8px'
          }}>
