const showActionToast = useCallback((message, type = 'success') => {
  const toastId = `toast-${Date.now()}`;
  const toast = {
    id: toastId,
    message,
    type,
    timestamp: Date.now()
  };
  
  setRecentActions(prev => [...prev.slice(-2), toast]); // Keep only last 3 toasts
  
  // Auto-remove toast after 1 second
  setTimeout(() => {
    setRecentActions(prev => prev.filter(t => t.id !== toastId));
  }, 1000)
}, []);




  // Initialize active players based on courtPlayers
useEffect(() => {
  if (!Array.isArray(courtPlayers)) return;

  setActivePlayerIds(prev => {
    return new Set(
      [...prev].filter(playerId =>
        courtPlayers.some(p => p && p._id === playerId && p.name !== "?")
      )
    );
  });
}, [courtPlayers]);
      
  
const addActionLogEntry = useCallback((action, options = {}) => {
  const actionEntry = {
    timestamp: Date.now(),
    action,
    userId: user?.id || user?._id,
    username: user?.displayName || user?.email?.split('@')[0] || 'A Former User',
    ...options
  };

  // 🔥 ONLY update local UI state - DON'T trigger saves
  if (collaborativeMode) {
    setActionLog(prev => [...prev, actionEntry]);
  } else {
    setActionLog(prev => [...prev, actionEntry]);
  }
  
  // Don't call triggerNonBlockingSave here!
  // Action log updates alone won't trigger saves anymore
}, [collaborativeMode, setActionLog, user]);

const setCurrentServeSideWithSync = useCallback((newServeSide) => {
  if (collaborativeMode && isConnected) {
    // Set local override first
    setLocalStateOverride({
      currentServeSide: newServeSide,
      timestamp: Date.now()
    });
    
    // Clear the override after a short delay
    if (localStateTimeoutRef.current) {
      clearTimeout(localStateTimeoutRef.current);
    }
    localStateTimeoutRef.current = setTimeout(() => {
      setLocalStateOverride(null);
    }, 1000);
    
    // COLLABORATIVE MODE: Send to server, but also update local immediately
    setCurrentServeSide(newServeSide);
    setBallSide(newServeSide);
    
    const syncSuccess = updateCollaborativeServeSide(newServeSide);
    
    if (!syncSuccess) {
      console.warn('Failed to sync serve side change');
      showActionToast('Failed to sync serve change', 'error');
    }
  } else {
    // NON-COLLABORATIVE MODE: Update directly
    setCurrentServeSide(newServeSide);
    setBallSide(newServeSide);
  }
}, [
  collaborativeMode, 
  isConnected, 
  updateCollaborativeServeSide,
  setCurrentServeSide, 
  setBallSide,
  showActionToast
]);

const formatPlayerAction = useCallback((player, action) => {
