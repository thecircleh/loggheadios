                    }}
                    onMouseOver={(e) => e.currentTarget.style.transform = 'scale(1.05)'}
                    onMouseOut={(e) => e.currentTarget.style.transform = 'scale(1)'}
                  >
                    {isOn ? '✓ ON' : '○ OFF'}
                  </button>
                </div>

                {/* Action Buttons - Show if player is ON */}
                {isOn && actionGroups.length > 0 && (
                  <div
                    style={{
                      display: 'flex',
                      flexDirection: 'column',
                      gap: '8px',
