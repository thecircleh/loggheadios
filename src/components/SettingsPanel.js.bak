  return (
    <div style={styles.container}>
      {/* ============================================ */}
      {/* SECTION 1: TEAM & ROSTER */}
      {/* ============================================ */}
      <h2 style={styles.header}>1. Team & Roster</h2>

      {/* Team Selection Card */}
      <div style={styles.card}>
        <h3 style={styles.cardTitle}>Select Team</h3>
        {loadingTeams ? (
          <p>Loading teams...</p>
        ) : (
          <>
            <select
              value={selectedTeam}
              onChange={(e) => handleTeamSelect(e.target.value)}
              style={styles.select}
            >
              <option value="">-- Select a Team --</option>
              {userTeams.map((team) => (
                <option key={team} value={team}>
                  {team}
                </option>
              ))}
            </select>

            <div style={{ marginTop: 14, display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'center' }}>
              {/* Create - always visible, filled green */}
              <button
                onClick={handleCreateTeam}
                style={{
                  padding: '9px 16px', fontSize: 14, fontWeight: 700,
                  background: 'linear-gradient(135deg, #16a34a, #15803d)',
                  color: '#fff', border: 'none', borderRadius: 10, cursor: 'pointer',
                  boxShadow: '0 3px 10px rgba(22,163,74,0.25)',
                }}
              >
                + New Team
              </button>

              {selectedTeam && (
                <>
                  {/* Archive - low-key outline blue */}
                  <button
                    onClick={() => handleArchiveTeam(selectedTeam)}
                    style={{
                      padding: '9px 16px', fontSize: 14, fontWeight: 600,
                      background: '#fff', color: '#2563eb',
                      border: '1.5px solid #2563eb', borderRadius: 10, cursor: 'pointer',
                    }}
                  >
                    Archive
                  </button>

                  {/* Delete - ghost red, least prominent */}
                  <button
                    onClick={() => handleDeleteTeam(selectedTeam)}
                    style={{
                      padding: '9px 16px', fontSize: 14, fontWeight: 600,
                      background: 'rgba(220,38,38,0.07)', color: '#dc2626',
                      border: '1.5px solid rgba(220,38,38,0.25)', borderRadius: 10, cursor: 'pointer',
                    }}
                  >
                    Delete
                  </button>
                </>
              )}

              {archivedTeams.length > 0 && (
                <button
                  onClick={() => setShowArchivedTeams(!showArchivedTeams)}
                  style={{
                    padding: '9px 16px', fontSize: 14, fontWeight: 600,
                    background: '#f3f4f6', color: '#6b7280',
                    border: '1.5px solid #e5e7eb', borderRadius: 10, cursor: 'pointer',
                  }}
                >
                  {showArchivedTeams ? 'Hide' : 'Archived'} ({archivedTeams.length})
                </button>
              )}
            </div>

            {showArchivedTeams && archivedTeams.length > 0 && (
              <div style={{
                marginTop: '12px',
                padding: '12px',
                backgroundColor: '#F5F5F5',
                borderRadius: '8px',
                border: '1px solid #D1D1D6'
              }}>
                <h4 style={{ marginTop: 0 }}>Archived Teams</h4>
                {archivedTeams.map((team) => (
                  <div key={team} style={{
                    display: 'flex',
                    justifyContent: 'space-between',
                    alignItems: 'center',
                    padding: '8px',
                    marginBottom: '8px',
                    backgroundColor: 'white',
                    borderRadius: '6px'
                  }}>
                    <span>{team}</span>
                    <button 
                      onClick={() => handleUnarchiveTeam(team)}
                      style={{
                        ...styles.secondaryButton,
                        padding: '6px 12px',
                        fontSize: '14px'
                      }}
                    >
                      Unarchive
                    </button>
                  </div>
                ))}
              </div>
            )}
          </>
        )}
      </div>

      {/* Team Roster Card */}
      <div style={styles.card}>
        <h3 style={styles.cardTitle}>Team Roster</h3>
        <div style={styles.rosterContainer}>

          {/* Always-open grid: existing players + add card */}
          <div style={gridContainerStyle}>

            {Array.isArray(benchPlayers) && benchPlayers.map((player) => (
              <div key={player._id} style={styles.playerCard}>
                <div style={styles.playerInfo}>
                  <div><span style={styles.playerName}>{(player.name || "").slice(0, 20)}</span></div>
                  <span style={styles.playerNumber}>#{player.number}</span>
                  <small style={{ fontSize: '14px', color: '#888' }}>{player.position || '—'}</small>
                  <div>
                    <select
                      value={player.position}
                      onChange={async (e) => {
                        const newPos = e.target.value;
                        e.preventDefault();
                        await axios.put(`${API_URL}/api/players/${player._id}`, { position: newPos });
                        handleRecallBench(selectedTeam);
                      }}
                      style={{ fontSize: '10px', marginTop: '4px', width: '80%' }}
                    >
                      <option value="">—</option>
                      <option value="OH">OH</option>
                      <option value="MB">MB</option>
                      <option value="S">S</option>
                      <option value="OPP">OPP</option>
                      <option value="DS">DS</option>
                    </select>
                  </div>
                </div>

                <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', marginTop: '8px' }}>
                  <span style={{ fontSize: '13px', fontWeight: '500', marginBottom: '4px' }}>Libero?</span>
                  <label
                    style={{
                      ...styles.toggleLabel,
                      backgroundColor: player.isLibero
                        ? styles.toggleChecked.backgroundColor
                        : styles.toggleLabel.backgroundColor,
                    }}
                  >
                    <input
                      type="checkbox"
                      checked={player.isLibero || false}
                      onChange={() => handleLiberoToggle(player._id)}
                      style={styles.toggleInput}
                    />
                    <span
                      style={{
                        ...styles.toggleSlider,
                        left: player.isLibero
                          ? styles.toggleSliderChecked.left
                          : styles.toggleSlider.left,
                      }}
                    />
                  </label>
                </div>

                <div style={{ display: 'flex', gap: '4px', marginTop: '8px', justifyContent: 'center' }}>
                  <button onClick={() => handleEditPlayer(player)} style={styles.editButton} title="Edit player">
                    <EditIcon size={15} color="#374151" />
                  </button>
                  <button onClick={() => handleFindPlayerOnTeams(player.name)} style={styles.linkButton} title="Find on other teams">
                    <LinkIcon size={15} color="#5856D6" />
                  </button>
                  <button onClick={() => handleDeletePlayer(player._id)} style={styles.deleteButton}>
                    <DeleteIcon size={15} color="#dc2626" />
                  </button>
                </div>
              </div>
            ))}

            {/* Add player — last card in grid, appears once a team is selected */}
            {selectedTeam && (
              <div
                style={{
                  ...styles.playerCard,
                  border: '1.5px dashed #d1d5db',
                  background: '#fafafa',
                  display: 'flex',
                  flexDirection: 'column',
                  gap: 8,
                  alignItems: 'stretch',
                  justifyContent: 'flex-start',
                }}
              >
                <div style={{ fontSize: 12, fontWeight: 700, color: '#9ca3af', textTransform: 'uppercase', letterSpacing: '0.5px', textAlign: 'center', marginBottom: 2 }}>
                  New Player
                </div>
                <input
                  type="text"
                  placeholder="Name"
                  value={newPlayerName}
                  onChange={(e) => setNewPlayerName(e.target.value)}
                  style={{ padding: '8px 10px', fontSize: 14, border: '1.5px solid #e5e7eb', borderRadius: 8, width: '100%', boxSizing: 'border-box' }}
                />
                <input
                  type="number"
                  placeholder="#"
                  value={newPlayerNumber}
                  onChange={(e) => setNewPlayerNumber(e.target.value)}
                  style={{ padding: '8px 10px', fontSize: 14, border: '1.5px solid #e5e7eb', borderRadius: 8, width: '100%', boxSizing: 'border-box' }}
                />
                <select
                  value={newPlayerPosition}
                  onChange={(e) => setNewPlayerPosition(e.target.value)}
                  style={{ padding: '8px 10px', fontSize: 14, border: '1.5px solid #e5e7eb', borderRadius: 8, width: '100%', boxSizing: 'border-box', background: '#fff' }}
                >
                  <option value="">Position</option>
                  <option value="OH">OH</option>
                  <option value="MB">MB</option>
                  <option value="S">S</option>
                  <option value="OPP">OPP</option>
                  <option value="DS">DS</option>
                </select>
                <button
                  onClick={handleAddPlayer}
                  style={{
                    padding: '9px 12px',
                    fontSize: 13,
                    fontWeight: 700,
                    background: 'linear-gradient(135deg, #2563eb, #1d4ed8)',
                    color: '#fff',
                    border: 'none',
                    borderRadius: 8,
                    cursor: 'pointer',
                    width: '100%',
                  }}
                >
                  {newPlayerNumber ? `Add #${newPlayerNumber}` : 'Add'}
                </button>
              </div>

            )}
          </div>{/* end grid */}

          {/* Copy Roster — only when roster is empty */}
          {(!benchPlayers || benchPlayers.length === 0) && selectedTeam && (
            <div style={{ textAlign: 'center', padding: '20px 0 8px' }}>
              <p style={{ color: '#9ca3af', fontSize: 14, marginBottom: 12 }}>
                No players yet — add one above or copy from another team.
              </p>
              <TeamCopyManager
                userTeams={userTeams}
                archivedTeams={archivedTeams}
                selectedTeam={selectedTeam}
                token={token}
                onTeamCopied={(teamName) => {
                  setSelectedTeam(teamName);
                  setMatchSettings((prev) => ({ ...prev, teamName: teamName }));
                  handleRecallBench(teamName);
                }}
                refreshBenchPlayers={() => handleRecallBench(selectedTeam)}
                initialSearchName={searchPlayerName}
                externalShowSearch={showExternalSearch}
                onCloseExternalSearch={handleCloseExternalSearch}
                inlineMode={true}
              />
            </div>
          )}

          {/* Recall / Reset — quiet text links, only when roster has players */}
          {benchPlayers && benchPlayers.length > 0 && selectedTeam && (
            <div style={{ display: 'flex', gap: 16, marginTop: 14, paddingTop: 14, borderTop: '1px solid #f3f4f6' }}>
              <button
                onClick={() => handleRecallBench(selectedTeam)}
                style={{ background: 'none', border: 'none', fontSize: 13, fontWeight: 600, color: '#6b7280', cursor: 'pointer', padding: 0 }}
              >
                ↺ Recall Roster
              </button>
              <button
                onClick={onResetBench}
                style={{ background: 'none', border: 'none', fontSize: 13, fontWeight: 600, color: '#dc2626', cursor: 'pointer', padding: 0 }}
              >
                ✕ Reset Roster
              </button>
            </div>
          )}

        </div>
      </div>



      {/* ============================================ */}
      {/* SECTION 2: MATCH SETTINGS */}
      {/* ============================================ */}
      <h2 style={styles.header}>2. Match Settings</h2>
      
      <div style={styles.card}>
        <div style={formContainerStyle}>
<div
  style={{
    display: 'flex',
    flexDirection: isMobile && isPortrait ? 'column' : 'row',
    gap: isMobile ? '10px' : '12px',
  }}
>
        <div style={{ ...fieldStyle, flex: 1 }}>      
          <label>Opponent</label>
          <input
  type="text"
  placeholder="Enter opponent name"
  value={opponentName}
  onFocus={() => {
    if (opponentName === 'Enter an Opponent') {
      setOpponentName('');
    }
  }}
  onChange={(e) => setOpponentName(e.target.value)}
  style={inputStyle}
          />
        </div>

        <div style={{ ...fieldStyle, flex: 1 }}>
          <label>Event</label>
          <input
            type="text"
            placeholder="Tournament Name or Other Descriptor"
            value={eventName}
            onChange={(e) => setEventName(e.target.value)}
            list="event-options"
            style={inputStyle}
          />
          <datalist id="event-options">
            {eventSuggestions.map((ev, i) => (
              <option key={i} value={ev} />
            ))}
          </datalist>
        </div>

        <div style={{ ...fieldStyle, flex: 1 }}>
          <label>Location</label>
          <input
            type="text"
            placeholder="City or Gym Name"
            value={location}
            onChange={(e) => setLocation(e.target.value)}
            list="location-options"
            style={inputStyle}
          />
          <datalist id="location-options">
            {locationSuggestions.map((loc, i) => (
              <option key={i} value={loc} />
            ))}
          </datalist>
        </div>
		</div>
<div
  style={{
    display: 'flex',
    flexDirection: isMobile && isPortrait ? 'column' : 'row',
    gap: isMobile ? '10px' : '12px',
  }}
>
        <div style={{ ...fieldStyle, flex: 1 }}>
          <label>Max Sets</label>
<input
  type="number"
  value={maxSets}
  onChange={(e) => {
    const value = e.target.value;
    setMaxSets(value === "" ? "" : Number(value));
  }}
  style={inputStyle}
/>
          <div style={fieldStyle}>
            <label style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
              <input
                type="checkbox"
                checked={playAllSets}
                onChange={(e) => setPlayAllSets(e.target.checked)}
              />
			  
              Play all sets regardless of outcome
            </label>
          </div>
        </div>


  <div style={{ ...fieldStyle, flex: 1 }}>
    <label>Points Per Set (Non-Deciding)</label>
    <input
      type="number"
      value={pointsNonDeciding}
      onChange={(e) => {
        const value = e.target.value;
        setPointsNonDeciding(value === "" ? "" : Number(value));
      }}
      style={inputStyle}
    />
  </div>

  <div style={{ ...fieldStyle, flex: 1 }}>
    <label>Deciding Set (Set {maxSets}) Points</label>
    <input
      type="number"
      value={pointsDeciding}
      onChange={(e) => {
        const value = e.target.value;
        setPointsDeciding(value === "" ? "" : Number(value));
      }}
      style={inputStyle}
    />
  </div>
</div>

		
		  <div
      style={{
        flex: '1 1 240px',
        minWidth: 0,
        backgroundColor: '#FFFFFF',
        borderRadius: 16,
        padding: 16,
        boxShadow: '0 4px 10px rgba(0,0,0,0.06)',
      }}
    >
      <h4 style={{ fontSize: 15, fontWeight: 600, marginBottom: 8 }}>
        Schedule this match
      </h4>
      <div style={{ display: 'flex', gap: 8, marginBottom: 8 }}>
        <input
          type="date"
          value={scheduleDate}
          onChange={(e) => setScheduleDate(e.target.value)}
          style={{ ...styles.input, flex: 1 }}
        />
        <input
          type="time"
          value={scheduleTime}
          onChange={(e) => setScheduleTime(e.target.value)}
          style={{ ...styles.input, flex: 1 }}
        />
      </div>
      <button
        onClick={handleScheduleMatch}
        style={{ ...styles.secondaryButton, width: '100%' }}
      >
        Schedule Match
      </button>
    </div>
      </div>
      </div>

      {/* ============================================ */}
      {/* SECTION 3: START MATCH */}
      {/* ============================================ */}
<div style={{ 
  marginLeft: isMobile && isPortrait ? 16 : 20,
  marginRight: isMobile && isPortrait ? 16 : 20,
}}>
  <h2 style={styles.header}>3. Start Match</h2>

  <div
    style={{
      display: 'flex',
      flexWrap: 'wrap',
      gap: 12,
      alignItems: 'flex-start',
      width: '100%',
      maxWidth: '100%',
      boxSizing: 'border-box',
    }}
  >
   

    {/* Start buttons card */}
    <div
      style={{
        flex: isMobile && isPortrait ? '1 1 100%' : '2 1 280px',
        width: isMobile && isPortrait ? '100%' : 'auto',
        maxWidth: '100%',
        backgroundColor: '#FFFFFF',
        borderRadius: 16,
        padding: isMobile && isPortrait ? 16 : 16,
        boxShadow: '0 4px 10px rgba(0,0,0,0.06)',
        boxSizing: 'border-box',
      }}
    >
      <p
        style={{
          fontSize: 24,
          color: '#6B7280',
          marginTop: 0,
          marginBottom: 10,
        }}
      >
        Choose how you want to log this match and start.
      </p>

      {(!selectedTeam || !benchPlayers || benchPlayers.length === 0) && (
        <div
          style={{
            padding: '12px 16px',
            backgroundColor: '#FFF3CD',
            border: '1px solid #FFC107',
            borderRadius: '8px',
            marginBottom: '12px',
            textAlign: 'center',
            color: '#856404',
            fontSize: '14px',
            fontWeight: '500'
          }}
        >
          ⚠️ {!selectedTeam 
            ? 'Please select a team with a roster before starting a match' 
            : 'Please add players to your roster before starting a match'}
        </div>
      )}

      <div style={{
        display: 'grid',
        gridTemplateColumns: isMobile && isPortrait ? '1fr' : 'repeat(3, 1fr)',
        gap: 12,
        width: '100%',
      }}>

        {/* Match Tracking - primary filled */}
        <button
          onClick={handleSaveAndStartMatchTracking}
          disabled={!selectedTeam || !benchPlayers || benchPlayers.length === 0}
          style={{
            display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center',
            gap: 6, padding: '18px 16px', border: 'none', borderRadius: 14, cursor: 'pointer',
            background: 'linear-gradient(135deg, #2563eb, #1d4ed8)',
            boxShadow: '0 4px 14px rgba(37,99,235,0.28)',
            color: '#fff', fontWeight: 700, fontSize: 15, lineHeight: 1.25,
            opacity: (!selectedTeam || !benchPlayers || benchPlayers.length === 0) ? 0.45 : 1,
            transition: 'opacity 0.15s',
          }}
        >
          <span style={{ fontSize: 22 }}>&#9889;</span>
          <span>Match Tracking</span>
          <span style={{ fontSize: 12, fontWeight: 500, opacity: 0.85 }}>Score + rotations</span>
        </button>

        {/* Stat Book - outlined */}
        <button
          onClick={handleExpressMatch}
          disabled={!selectedTeam || !benchPlayers || benchPlayers.length === 0}
          style={{
            display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center',
            gap: 6, padding: '18px 16px', border: '2px solid #2563eb', borderRadius: 14, cursor: 'pointer',
            background: '#fff',
            color: '#2563eb', fontWeight: 700, fontSize: 15, lineHeight: 1.25,
            opacity: (!selectedTeam || !benchPlayers || benchPlayers.length === 0) ? 0.45 : 1,
            transition: 'opacity 0.15s',
          }}
        >
          <span style={{ fontSize: 22 }}>&#128203;</span>
          <span>Stat Book</span>
          <span style={{ fontSize: 12, fontWeight: 500, opacity: 0.7 }}>Full stat logging</span>
        </button>

        {/* Classic - ghost */}
        <button
          onClick={handleSaveAndStartMatch}
          disabled={!selectedTeam || !benchPlayers || benchPlayers.length === 0}
          style={{
            display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center',
            gap: 6, padding: '18px 16px', border: '1.5px solid #d1d5db', borderRadius: 14, cursor: 'pointer',
            background: '#f9fafb',
            color: '#374151', fontWeight: 600, fontSize: 15, lineHeight: 1.25,
            opacity: (!selectedTeam || !benchPlayers || benchPlayers.length === 0) ? 0.45 : 1,
            transition: 'opacity 0.15s',
          }}
        >
          <span style={{ fontSize: 22 }}>&#127952;</span>
          <span>Classic</span>
          <span style={{ fontSize: 12, fontWeight: 500, opacity: 0.6 }}>Gameflow mode</span>
        </button>
      </div>
    </div>
  </div>


  {toastVisible && (
    <div
      style={{
        position: 'fixed',
        top: '20px',
        left: '50%',
        transform: 'translateX(-50%)',
        backgroundColor: '#4CAF50',
        color: 'white',
        padding: '10px 20px',
        borderRadius: '8px',
        boxShadow: '0 2px 8px rgba(0,0,0,0.2)',
        fontSize: '18px',
        fontWeight: 'bold',
        zIndex: 9999,
      }}
    >
      ✅ Match Created!
    </div>
  )}

  {isRestoring && (
    <div
      style={{
        position: 'fixed',
        top: 0,
        left: 0,
        right: 0,
        bottom: 0,
        backgroundColor: 'rgba(255, 255, 255, 0.8)',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        zIndex: 9999,
        fontSize: '24px',
        fontWeight: '600',
        color: '#007AFF',
      }}
    >
      Restoring Match...
    </div>
  )}
</div>

      {/* ============================================ */}
      {/* SECTION 4: SAVED MATCHES */}
      {/* ============================================ */}
      <h2 style={styles.header}>4. Saved Matches</h2>

{/* Scheduled Matches Card */}
<div style={{ 
  marginLeft: isMobile && isPortrait ? 16 : 20,
  marginRight: isMobile && isPortrait ? 16 : 20,
}}>
  <div style={styles.card}>
    <h3 style={styles.cardTitle}>📅 Scheduled Matches</h3>
    
    {(!selectedTeam || !benchPlayers || benchPlayers.length === 0) && scheduledMatches.length > 0 && (
      <div
        style={{
          padding: '12px 16px',
          backgroundColor: '#FFF3CD',
          border: '1px solid #FFC107',
          borderRadius: '8px',
          marginBottom: '12px',
          textAlign: 'center',
          color: '#856404',
          fontSize: '14px',
          fontWeight: '500'
        }}
      >
        ⚠️ {!selectedTeam 
          ? 'Select a team with a roster to start scheduled matches' 
          : 'Add players to your roster to start scheduled matches'}
      </div>
    )}
    
    {scheduledMatches.length === 0 ? (
      <p style={{ fontStyle: 'italic', color: '#666' }}>
        No scheduled matches.
      </p>
    ) : (
      <ul style={{ listStyle: 'none', padding: 0 }}>
        {scheduledMatches.map((match) => (
          <li
            key={match._id}
            style={{
              display: 'flex',
              justifyContent: 'space-between',
              alignItems: 'center',
              padding: '10px',
              borderRadius: '10px',
              backgroundColor: '#f5f5f7',
              marginBottom: '8px',
            }}
          >
            <span style={{ fontSize: '14px' }}>
              {match.teamName} vs {match.opponentName}{' '}
              {match.scheduledFor
                ? `(${new Date(match.scheduledFor).toLocaleString()})`
                : ''}
            </span>
			  <span style={styles.matchOwnerInfo}>
    Match Scheduled by: {match.userDisplayName || match.userEmail || 'A Former User'}
  </span>
            <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', marginTop: 8 }}>
              <button
                onClick={() => handleStartScheduledMatch(match, 'match')}
                disabled={(!selectedTeam || !benchPlayers || benchPlayers.length === 0)}
                style={{
                  display: 'flex', alignItems: 'center', gap: 5,
                  padding: '7px 12px', fontSize: 13, fontWeight: 700,
                  border: 'none', borderRadius: 8, cursor: 'pointer',
                  opacity: (!selectedTeam || !benchPlayers || benchPlayers.length === 0) ? 0.45 : 1,
                  background: 'linear-gradient(135deg, #2563eb, #1d4ed8)', color: '#fff',
                }}
              >
                <LightningIcon size={13} color='#fff' />
                <span>Match Tracking</span>
              </button>

              <button
                onClick={() => handleStartScheduledMatch(match, 'statbook')}
                disabled={(!selectedTeam || !benchPlayers || benchPlayers.length === 0)}
                style={{
                  display: 'flex', alignItems: 'center', gap: 5,
                  padding: '7px 12px', fontSize: 13, fontWeight: 700,
                  border: 'none', borderRadius: 8, cursor: 'pointer',
                  opacity: (!selectedTeam || !benchPlayers || benchPlayers.length === 0) ? 0.45 : 1,
                  background: '#fff', color: '#2563eb', border: '1.5px solid #2563eb',
                }}
              >
                <LightningIcon size={13} color='#2563eb' />
                <span>Stat Book</span>
              </button>

              <button
                onClick={() => handleStartScheduledMatch(match, 'classic')}
                disabled={(!selectedTeam || !benchPlayers || benchPlayers.length === 0)}
                style={{
                  display: 'flex', alignItems: 'center', gap: 5,
                  padding: '7px 12px', fontSize: 13, fontWeight: 700,
                  border: 'none', borderRadius: 8, cursor: 'pointer',
                  opacity: (!selectedTeam || !benchPlayers || benchPlayers.length === 0) ? 0.45 : 1,
                  background: '#f3f4f6', color: '#374151', border: '1.5px solid #e5e7eb',
                }}
              >
                <PlayIcon size={13} color='#374151' />
                <span>Classic</span>
              </button>

              <button
                onClick={() => handleDeleteMatch(match._id)}
                style={{
                  display: 'flex', alignItems: 'center', justifyContent: 'center',
                  padding: '7px 10px', background: 'rgba(220,38,38,0.07)',
                  color: '#dc2626', border: '1.5px solid rgba(220,38,38,0.2)',
                  borderRadius: 8, cursor: 'pointer',
                }}
                title='Delete scheduled match'
              >
                <DeleteIcon size={14} color='#dc2626' />
              </button>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</div>

{/* In Process Matches Card */}
<div style={{ 
  marginLeft: isMobile && isPortrait ? 16 : 20,
  marginRight: isMobile && isPortrait ? 16 : 20,
}}>
  <div style={styles.card}>
    <h3 style={styles.cardTitle}>
      <InProcessIcon size={20} />
      In Process Matches
    </h3>

  {inProcessMatches.length === 0 ? (
    <p style={{ fontStyle: 'italic', color: '#666' }}>
      No in-process matches for {selectedTeam || 'selected team'}.
    </p>
  ) : (
    Object.entries(groupedInProcessByEvent).map(([eventName, matches]) => (
      <div key={`inprocess-${eventName}`}>
        <h4 style={{ fontSize: '15px', fontWeight: 600, marginTop: '12px' }}>
          {eventName}
        </h4>
        {matches.map((match) => {
          const isCoachMode = (match.mode || "").toLowerCase() === "match";
          const matchStyle = isCoachMode 
            ? { 
                ...styles.savedMatchItem, 
                backgroundColor: '#E8F5E9',  // Light green background
                border: '1px solid #A5D6A7',  // Subtle green border
                marginBottom: 10 
              }
            : { ...styles.savedMatchItem, marginBottom: 10 };
          
          return (
            <div key={match._id} style={matchStyle}>
              <div style={styles.savedMatchInfo}>
                <span style={styles.matchTitle}>
                  {match.teamName} ({match.ourSetsWon}) vs {match.opponentName} ({match.opponentSetsWon})
                </span>
                <span style={styles.matchDetails}>
                  Set {match.currentSet} — {match.ourScore} : {match.opponentScore}
                  {match.playAllSets && (
                    <span style={{ display: 'inline-flex', alignItems: 'center', marginLeft: 4 }}>
                      <SigmaIcon size={14} />
                    </span>
                  )}
                </span>
			    <span style={styles.matchOwnerInfo}>
    Match by: {match.userDisplayName || match.userEmail || 'A Former User'}
  </span>
            </div>
            {renderMatchActions(match)}
          </div>
          );
        })}
      </div>
    ))
  )}
  </div>
</div>

{/* Final Matches Card */}
<div style={{ 
  marginLeft: isMobile && isPortrait ? 16 : 20,
  marginRight: isMobile && isPortrait ? 16 : 20,
}}>
  <div style={styles.card}>
    <h3 style={styles.cardTitle}>
      <CheckmarkIcon size={20} />
      Final Matches
    </h3>

  {finalMatches.length === 0 ? (
    <p style={{ fontStyle: 'italic', color: '#666' }}>
      No final matches for {selectedTeam || 'selected team'}.
    </p>
  ) : (
    Object.entries(groupedFinalByEvent).map(([eventName, matches]) => (
      <div key={`final-${eventName}`}>
        <h4 style={{ fontSize: '15px', fontWeight: 600, marginTop: '12px' }}>
          {eventName}
        </h4>
        {matches.map((match) => {
          const isCoachMode = (match.mode || "").toLowerCase() === "match";
          const matchStyle = isCoachMode
            ? {
                ...styles.savedMatchItem,
                marginBottom: 10,
                backgroundColor: '#E8F5E9',  // Light green for Coach mode
                border: '1px solid #81C784',  // Slightly darker green border for Coach
              }
            : {
                ...styles.savedMatchItem,
                marginBottom: 10,
                backgroundColor: '#F6FFED',  // Default final match green
                border: '1px solid #B7EB8F',
              };
          
          return (
            <div
              key={match._id}
              style={matchStyle}
            >
              <div style={styles.savedMatchInfo}>
                <span style={styles.matchTitle}>
                  {match.teamName} ({match.ourSetsWon})
                  {match.ourSetsWon > match.opponentSetsWon && (
                    <span style={{ display: 'inline-flex', alignItems: 'center', marginLeft: 4 }}>
                      <TrophyIcon size={16} />
                    </span>
                  )}
                  {" vs "}
                  {match.opponentName} ({match.opponentSetsWon})
                  {match.opponentSetsWon > match.ourSetsWon && (
                    <span style={{ display: 'inline-flex', alignItems: 'center', marginLeft: 4 }}>
                      <TrophyIcon size={16} />
                    </span>
                  )}
                </span>
			    <span style={styles.matchOwnerInfo}>
    Match by: {match.userDisplayName || match.userEmail || 'A Former User'}
  </span>
            </div>
            {renderMatchActions(match)}
          </div>
          );
        })}
      </div>
    ))
  )}
  </div>
</div>


      {renderEditModal()}
      {renderPlayerEditModal()}
      
{showTeamNameBuilder && (
  <div
    style={styles.modalOverlay}
    onClick={(e) => {
      if (e.target === e.currentTarget) setShowTeamNameBuilder(false);
    }}
  >
    <div style={styles.modalContent} onClick={(e) => e.stopPropagation()}>
      <TeamNameBuilder
        apiUrl={API_URL}
        token={token}
        onAddTeam={handleTeamNameBuilderSubmit}
        overlay
        onClose={() => setShowTeamNameBuilder(false)}
      />
    </div>
  </div>
)}
    </div>
  );
};

export default SettingsPanel;