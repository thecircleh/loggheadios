const LinkIcon = ({ size = 16, color = "#FFFFFF" }) => (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M10 13C10.4295 13.5741 10.9774 14.0492 11.6066 14.3929C12.2357 14.7367 12.9315 14.9411 13.6467 14.9923C14.3618 15.0435 15.0796 14.9404 15.7513 14.6898C16.4231 14.4392 17.0331 14.0471 17.54 13.54L20.54 10.54C21.4508 9.59698 21.9548 8.33397 21.9434 7.02299C21.932 5.71201 21.4061 4.45794 20.4791 3.53091C19.5521 2.60389 18.298 2.07802 16.987 2.06663C15.676 2.05523 14.413 2.55921 13.47 3.47L11.75 5.18" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
    <path d="M14 11C13.5705 10.4259 13.0226 9.95083 12.3934 9.60707C11.7643 9.26331 11.0685 9.05889 10.3533 9.00768C9.63819 8.95646 8.92037 9.0596 8.24861 9.31018C7.57685 9.56077 6.96689 9.9529 6.46 10.46L3.46 13.46C2.54921 14.403 2.04523 15.666 2.05662 16.977C2.06802 18.288 2.59389 19.5421 3.52091 20.4691C4.44794 21.3961 5.70201 21.922 7.01299 21.9334C8.32397 21.9448 9.58698 21.4408 10.53 20.53L12.24 18.82" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
  </svg>
);

const SettingsPanel = ({
  matchSettings,
  setMatchSettings,
  setCurrentMatchId,
  currentMatchId,
  refreshBenchPlayers,
  refreshCourtPlayers,
  benchPlayers,
  setBenchPlayers,
  isMobile,
  isPortrait,
  isTouch,
  onCreatePlayer,
  onDeletePlayer,
  onResetBench,
  refreshBench,
  onRecallBench,
  handleNewMatch,
  resetMatchStateOnly, 
  saveMatchData,
  setSubstitutionLog,
  setActionLog,
  setAllowedLiberoSubTarget,
  setSlot5TargetId,
  ourSetsWon,
  opponentSetsWon,
  setOurSetsWon,
  setOpponentSetsWon,
  ourScore,
  opponentScore,
  handleDeletePlayer,
  setOurScore,
  setOpponentScore,
  courtPlayers,
  setCourtPlayers,
  substitutionLog,
  actionLog,
  playerStats,
  allowedLiberoSubTarget,
  slot5TargetId,
  saveCurrentMatchToDB,
  opponentName,
  setOpponentName
}) => {
  const { user, token, isSubscriber, hasCoachesCorner, hasPremium } = useAuth();
  const [userTeams, setUserTeams] = useState([]);
  const [loadingTeams, setLoadingTeams] = useState(true);
  const [archivedTeams, setArchivedTeams] = useState([]);
  const [showArchivedTeams, setShowArchivedTeams] = useState(false);
  const navigate = useNavigate();
  const routerLocation = useLocation(); // Renamed to avoid conflict with match location
  
  const [eventName, setEventName] = useState(() => matchSettings?.eventName ?? '');
  const [location, setLocation] = useState(() => matchSettings?.location ?? '');
  const [maxSets, setMaxSets] = useState(() => matchSettings?.totalSets ?? 3);
  const [playAllSets, setPlayAllSets] = useState(() => matchSettings?.playAllSets ?? false);
  const [pointsNonDeciding, setPointsNonDeciding] = useState(() => matchSettings?.pointsNonDeciding ??  25);
  const [pointsDeciding, setPointsDeciding] = useState(() => matchSettings?.pointsDeciding ?? 15);
  const [newPlayerName, setNewPlayerName] = useState('');
  const [newPlayerNumber, setNewPlayerNumber] = useState('');
  const [savedMatches, setSavedMatches] = useState([]);
  const [scheduledMatches, setScheduledMatches] = useState([]);
  const [scheduleDate, setScheduleDate] = useState('');
  const [scheduleTime, setScheduleTime] = useState('');
  const [newPlayerPosition, setNewPlayerPosition] = useState('');
  const [selectedTeam, setSelectedTeam] = useState(() => matchSettings?.teamName || '');
  const [toastVisible, setToastVisible] = useState(false);
  const [isRestoring, setIsRestoring] = useState(false);
  const [eventSuggestions, setEventSuggestions] = useState([]);
  const [locationSuggestions, setLocationSuggestions] = useState([]);
  const previousUserIdRef = useRef(null);
  const [matchAssignments, setMatchAssignments] = useState({});
  const [editingMatch, setEditingMatch] = useState(null);
  const [searchPlayerName, setSearchPlayerName] = useState('');
  const [showExternalSearch, setShowExternalSearch] = useState(false);
  const [showTeamNameBuilder, setShowTeamNameBuilder] = useState(false);
  
  // NEW: State for editing players
  const [editingPlayer, setEditingPlayer] = useState(null);
  const [playerEditFormData, setPlayerEditFormData] = useState({
    name: '',
    number: '',
    position: '',
    isLibero: false
  });

  const [editFormData, setEditFormData] = useState({
    opponentName: '',
    eventName: '',
    location: '',
    totalSets: 3,
    playAllSets: false,
    pointsNonDeciding: 25,
    pointsDeciding: 15
  });

  
  useEffect(() => {
    if (matchSettings?.teamName && selectedTeam !== matchSettings.teamName) {
      setSelectedTeam(matchSettings.teamName);
    }
  }, [matchSettings?.teamName]);
  
  useEffect(() => {
  if (!matchSettings) return;

  // Keep the SettingsPanel controls aligned with the authoritative matchSettings
  if (typeof matchSettings.totalSets === "number") setMaxSets(matchSettings.totalSets);

  if (typeof matchSettings.playAllSets === "boolean") setPlayAllSets(matchSettings.playAllSets);

  if (matchSettings.eventName !== undefined) setEventName(matchSettings.eventName ?? "");
  if (matchSettings.location !== undefined) setLocation(matchSettings.location ?? "");

 if (matchSettings.opponentName !== undefined) setOpponentName(matchSettings.opponentName ?? "");

  if (typeof matchSettings.pointsNonDeciding === "number") setPointsNonDeciding(matchSettings.pointsNonDeciding);
  if (typeof matchSettings.pointsDeciding === "number") setPointsDeciding(matchSettings.pointsDeciding);
}, [
  matchSettings?.totalSets,
  matchSettings?.playAllSets,
  matchSettings?.eventName,
  matchSettings?.location,
  matchSettings?.opponentName,
  matchSettings?.pointsNonDeciding,
  matchSettings?.pointsDeciding,
]);

  useEffect(() => {
    const currentUserId = user?.id;
    const previousUserId = previousUserIdRef.current;

    if (previousUserId && currentUserId !== previousUserId) {
      console.log("User actually changed, clearing state for new user:", currentUserId);
      
      setBenchPlayers([]);
      setSavedMatches([]);
      setEventSuggestions([]);
      setLocationSuggestions([]);
      setSelectedTeam('');
      setMatchAssignments({});
      
      setEventName('');
      setLocation('');
      setOpponentName('');
      setMaxSets(3);
      setPlayAllSets(false);
      setPointsNonDeciding(25);
      setPointsDeciding(15);
      
      setMatchSettings(prev => ({
        ...prev,
        teamName: '',
        opponentName: '',
        eventName: '',
        location: '',
        currentSet: 1,
        totalSets: 3,
        pointsNonDeciding: 25,
        pointsDeciding: 15,
      }));
    } else if (previousUserId && !currentUserId) {
      console.log("User logged out, clearing state");
      setBenchPlayers([]);
      setSavedMatches([]);
      setEventSuggestions([]);
      setLocationSuggestions([]);
      setSelectedTeam('');
      setMatchAssignments({});
      setEventName('');
      setLocation('');
      setOpponentName('');
      setMaxSets(3);
      setPlayAllSets(false);
      setPointsNonDeciding(25);
      setPointsDeciding(15);
      setMatchSettings(null);
    }

    previousUserIdRef.current = currentUserId;
  }, [user?.id, setBenchPlayers, setOpponentName, setMatchSettings]);

  const handleRecallBench = useCallback(async (teamName) => {
    const res = await axios.get(`${API_URL}/api/players/bench/recall`, { 
  params: { team: teamName },
  headers: { Authorization: `Bearer ${token}` }
});
    setBenchPlayers(res.data);
  }, [setBenchPlayers]);
  
  const handleArchiveTeam = async (teamName) => {
    if (!window.confirm(`Archive team "${teamName}"? You can unarchive it later.`)) {
      return;
    }

    try {
      const res = await axios.post(
        `${API_URL}/api/users/${user.id}/teams/archive`,
        { teamName },
        { headers: { Authorization: `Bearer ${token}` } }
      );

      setUserTeams(res.data.teams);
      setArchivedTeams(res.data.archivedTeams || []);
      
      if (selectedTeam === teamName) {
        setSelectedTeam('');
        setBenchPlayers([]);
      }

      alert('Team archived successfully!');
    } catch (err) {
      console.error('Failed to archive team:', err);
      alert(err.response?.data?.message || 'Failed to archive team. Please try again.');
    }
  };

  const handleUnarchiveTeam = async (teamName) => {
    try {
      const res = await axios.post(
        `${API_URL}/api/users/${user.id}/teams/unarchive`,
        { teamName },
        { headers: { Authorization: `Bearer ${token}` } }
      );

      setUserTeams(res.data.teams);
      setArchivedTeams(res.data.archivedTeams || []);
      
      alert('Team unarchived successfully!');
    } catch (err) {
      console.error('Failed to unarchive team:', err);
      alert(err.response?.data?.message || 'Failed to unarchive team. Please try again.');
    }
  };  

  useEffect(() => {
    const fetchTeams = async () => {
      setLoadingTeams(true);
      
      try {
        if (!user || !user.id) {
          setUserTeams([]);
          setBenchPlayers([]);
          setSelectedTeam('');
          return;
        }

        setUserTeams([]);
        setBenchPlayers([]);
        
        const res = await axios.get(`${API_URL}/api/users/${user.id}`, {
          headers: { Authorization: `Bearer ${token}` }
        });

        if (res.data && Array.isArray(res.data.teams)) {
          setUserTeams(res.data.teams);
          setArchivedTeams(res.data.archivedTeams || []);

          if (!selectedTeam && res.data.teams.length > 0) {
            const defaultTeam = res.data.teams[0];
            setSelectedTeam(defaultTeam);
            setMatchSettings(prev => ({
              ...prev,
              opponentName: prev?.opponentName || opponentName || null,
              teamName: defaultTeam
            }));
            handleRecallBench(defaultTeam);
          }
        } else {
          console.warn("No teams found in user profile.");
          setUserTeams([]);
          setArchivedTeams([]);
          setBenchPlayers([]);
          setSelectedTeam('');
        }
      } catch (err) {
        console.error("Failed to fetch user teams:", err);
        setArchivedTeams([]);
        setUserTeams([]);
        setBenchPlayers([]);
        setSelectedTeam('');
      } finally {
        setLoadingTeams(false);
      }
    };
    
    fetchTeams();
  }, [user?.id, token, selectedTeam, setMatchSettings, handleRecallBench, setBenchPlayers]); 

  const handleEditMatch = (match) => {
    setEditingMatch(match);
    setEditFormData({
      opponentName: match.opponentName || '',
      eventName: match.eventName || '',
      location: match.location || '',
      totalSets: match.totalSets || 3,
      playAllSets: match.playAllSets || false,
      pointsNonDeciding: match.pointsNonDeciding || 25,
      pointsDeciding: match.pointsDeciding || 15
    });
  };
  
  const handleSaveEditedMatch = async () => {
    if (!editingMatch) return;
    
    try {
      await axios.put(`${API_URL}/api/matches/${editingMatch._id}`, editFormData, {
        headers: { Authorization: `Bearer ${token}` }
      });
      
      setSavedMatches(prev => 
        prev.map(m => m._id === editingMatch._id ? { ...m, ...editFormData } : m)
      );
      
      setEditingMatch(null);
      alert('Match updated successfully!');
    } catch (err) {
      console.error('Failed to update match:', err);
      alert(err.response?.data?.message || 'Failed to update match. Please try again.');
    }
  };

  // NEW: Handler to open player edit modal
  const handleEditPlayer = (player) => {
    setEditingPlayer(player);
    setPlayerEditFormData({
      name: player.name || '',
      number: player.number || '',
      position: player.position || '',
      isLibero: player.isLibero || false
    });
  };

  // NEW: Handler to save edited player
  const handleSaveEditedPlayer = async () => {
    if (!editingPlayer) return;
    
    try {
      // Validate number
      const playerNumber = parseInt(playerEditFormData.number);
      if (isNaN(playerNumber) || playerNumber < 0) {
        alert('Please enter a valid player number (0 or greater)');
        return;
      }

      // Validate name
      if (!playerEditFormData.name.trim()) {
        alert('Please enter a player name');
        return;
      }

      // Check if number is already taken by another player
      const existingPlayer = benchPlayers.find(
        p => p._id !== editingPlayer._id && 
        p.number === playerNumber
      );

      if (existingPlayer) {
        alert(`Player #${playerNumber} already exists (${existingPlayer.name}). Please choose a different number.`);
        return;
      }

      // Update player via API
      await axios.put(
  `${API_URL}/api/players/${editingPlayer._id}`,
  {
    name: playerEditFormData.name.trim(),
    number: playerNumber,
    position: playerEditFormData.position,
    isLibero: playerEditFormData.isLibero
  },
  { headers: { Authorization: `Bearer ${token}` } }
);
      
      // Refresh the bench to get updated data
      await handleRecallBench(selectedTeam);
      
      // Close modal
      setEditingPlayer(null);
      alert('Player updated successfully!');
      
    } catch (err) {
      console.error('Failed to update player:', err);
      alert(err.response?.data?.error || 'Failed to update player. Please try again.');
    }
  };

  const handleCreateTeam = () => {
    setShowTeamNameBuilder(true);
  };

const handleTeamNameBuilderSubmit = async (teamName, logoUrl = null) => {
  if (!teamName || teamName.trim() === "") return;
  
  try {
    const payload = { teamName };
    if (logoUrl) {
      payload.logoUrl = logoUrl;
    }
    
    await axios.post(
      `${API_URL}/api/users/${user.id}/teams`,
      payload,
      { headers: { Authorization: `Bearer ${token}` } }
    );
    
    const res = await axios.get(`${API_URL}/api/users/${user.id}`, {
      headers: { Authorization: `Bearer ${token}` }
    });
    
    setUserTeams(res.data.teams);
    setArchivedTeams(res.data.archivedTeams || []);
    setSelectedTeam(teamName);
    setMatchSettings((prev) => ({ ...prev, teamName: teamName }));
    
    setShowTeamNameBuilder(false);
    alert(`Team "${teamName}" created!`);
  } catch (err) {
    console.error("Failed to create team:", err);
    alert(err.response?.data?.message || "Failed to create team.");
  }
};

  const handleDeleteTeam = async (teamName) => {
    if (!window.confirm(`Delete team "${teamName}" permanently? This cannot be undone.`)) {
      return;
    }

    try {
    await axios.delete(
      `${API_URL}/api/users/${user.id}/teams/${encodeURIComponent(teamName)}`,
      { headers: { Authorization: `Bearer ${token}` } }
    );

      const res = await axios.get(`${API_URL}/api/users/${user.id}`, {
        headers: { Authorization: `Bearer ${token}` }
      });
      
      setUserTeams(res.data.teams);
      setArchivedTeams(res.data.archivedTeams || []);
      
      if (selectedTeam === teamName) {
        setSelectedTeam('');
        setBenchPlayers([]);
      }

      alert('Team deleted successfully!');
    } catch (err) {
      console.error('Failed to delete team:', err);
      alert(err.response?.data?.message || 'Failed to delete team. Please try again.');
    }
  };

const handleAddPlayer = async (e) => {
	e.preventDefault();
  if (!newPlayerName.trim() || !newPlayerNumber) {
    alert("Name and Number are required.");
    return;
  }

  const playerNumber = parseInt(newPlayerNumber);
  if (isNaN(playerNumber) || playerNumber < 0) {
    alert("Please enter a valid number (0 or greater).");
    return;
  }

  try {
    const res = await axios.post(
      `${API_URL}/api/players`, 
      {
        name: newPlayerName.trim(),
        number: playerNumber,
        position: newPlayerPosition || "Unknown",
        isLibero: false,
        team: selectedTeam,
      },
      {
        headers: { Authorization: `Bearer ${token}` }  // ← ADD THIS
      }
    );

    setBenchPlayers((prev) => [...prev, res.data]);

    setNewPlayerName("");
    setNewPlayerNumber("");
    setNewPlayerPosition("");
  } catch (err) {
    console.error("Error adding player:", err);
    alert(err.response?.data?.error || "Failed to add player.");
  }
};

  useEffect(() => {
    if (selectedTeam && user?.id) {
      handleRecallBench(selectedTeam);
    }
  }, [selectedTeam, user?.id, handleRecallBench]);

useEffect(() => {
  const fetchSavedMatches = async () => {
    if (!user?.id || !selectedTeam) {
      setSavedMatches([]);
      setScheduledMatches([]);
      setEventSuggestions([]);
      setLocationSuggestions([]);
      setMatchAssignments({});
      return;
    }

    setSavedMatches([]);
    setScheduledMatches([]);
    setEventSuggestions([]);
    setLocationSuggestions([]);
    setMatchAssignments({});

    try {
      const res = await axios.get(
        `${API_URL}/api/matches/recall?teamName=${encodeURIComponent(selectedTeam)}`,
        { headers: { Authorization: `Bearer ${token}` } }
      );

      const matches = Array.isArray(res.data) ? res.data : [];

      // Enhance matches with creator info - fix issue where former user displays for current user's matches
      const enhancedMatches = matches.map((match) => {
        // If this is the current user's match, ensure their info is populated
        if (match.userId === user.id || match.userId === user._id) {
          return {
            ...match,
            userDisplayName: match.userDisplayName || user?.displayName || user?.name || user?.email || 'You',
            userEmail: match.userEmail || user?.email || ''
          };
        }
        // Otherwise keep the original data (which may have been stored from when the match was created)
        return match;
      });

      // split into saved vs scheduled
      const scheduled = enhancedMatches.filter((m) => m.isScheduled);
      const saved = enhancedMatches.filter((m) => !m.isScheduled);

      setSavedMatches(saved);
      setScheduledMatches(scheduled);

      // suggestions can come from all matches (or just `saved`, your call)
      const allEvents = new Set();
      const allLocations = new Set();

      enhancedMatches.forEach((match) => {
        if (match.eventName) allEvents.add(match.eventName);
        if (match.location) allLocations.add(match.location);
      });

      setEventSuggestions(Array.from(allEvents));
      setLocationSuggestions(Array.from(allLocations));
    } catch (err) {
      console.error('Failed to fetch saved matches', err);
      setSavedMatches([]);
      setScheduledMatches([]);
      setEventSuggestions([]);
      setLocationSuggestions([]);
      setMatchAssignments({});
    }
  };

  fetchSavedMatches();
}, [user?.id, user?.displayName, user?.name, user?.email, selectedTeam, token]);


  const checkUserHasAssignment = useCallback(async (matchId) => {
    if (!user?.id || !matchId) return false;
    
    try {
      const response = await axios.get(`${API_URL}/api/matches/${matchId}/assignments`, {
        headers: { Authorization: `Bearer ${token}` },
        withCredentials: true
      });
      
      const assignments = response.data.assignments || [];
      const hasAssignment = assignments.some(
        assignment => assignment.assignedTo?.userId === user.id && assignment.isActive !== false
      );
      
      setMatchAssignments(prev => ({
        ...prev,
        [matchId]: { hasAssignment, checked: true }
      }));
      
      return hasAssignment;
    } catch (error) {
      console.error('Failed to check assignments for match:', matchId, error);
      return false;
    }
  }, [user?.id, token]);

  useEffect(() => {
    const checkAssignmentsForMatches = async () => {
      if (!savedMatches.length || !user?.id) return;
      
      const collaborativeMatches = savedMatches.filter(
        match => match.collaborativeMode?.enabled && match.userId !== user.id
      );
      
      for (const match of collaborativeMatches) {
        if (!matchAssignments[match._id]?.checked) {
          await checkUserHasAssignment(match._id);
        }
      }
    };
    
    checkAssignmentsForMatches();
  }, [savedMatches, user?.id, matchAssignments, checkUserHasAssignment]);

  const handleResumeButton = async (match) => {
    setIsRestoring(true);

    try {
      // Use handleResumeMatch which properly restores the mode and navigates correctly
      await handleResumeMatch(match);
    } catch (error) {
      console.error("Failed during match resume:", error);
      alert("Error restoring match. Please try again.");
    } finally {
      setIsRestoring(false);
    }
  };

  const renderMatchActions = (match) => {
    const isOwner = match.userId === user?.id;
    const hasCollaborativeMode = match.collaborativeMode?.enabled || false;
    const isFinalMatch = match.status === 'Final';
    const isCoachMode = (match.mode || "").toLowerCase() === "match";
    
    const cachedAssignment = matchAssignments[match._id];
    const hasAssignment = cachedAssignment?.hasAssignment || false;
 const canJoinAsNonPremium = !hasPremium && hasAssignment;
const canJoin = isOwner || hasPremium || canJoinAsNonPremium;

    return (
<div
  style={{
    ...styles.matchActions,
    ...(isMobile ? styles.matchActionsMobile : styles.matchActionsDesktop),
  }}
>
  {isCoachMode ? (
    <button
      onClick={() => navigate(`/coaches-corner/stats?match=${match._id}`)}
      style={{ ...styles.iosActionButton, ...styles.primaryActionButton }}
    >
      <div style={styles.iosActionInner}>
        <StatsIcon size={16} />
        <span>View Match Analysis</span>
      </div>
    </button>
  ) : (
    <button
      onClick={() =>
        navigate(`/stats?match=${match._id}&team=${encodeURIComponent(match.teamName)}`)
      }
      style={{ ...styles.iosActionButton, ...styles.primaryActionButton }}
    >
      <div style={styles.iosActionInner}>
        <StatsIcon size={16} />
        <span>View Stats</span>
      </div>
    </button>
  )}

  {!isFinalMatch && (
    <>
      {hasCollaborativeMode && (
        <button
          onClick={() => (canJoin ? handleCollaborativeJoin(match) : null)}
          style={{
            ...styles.iosActionButton,
            ...(isOwner ? styles.resumeActionButton : styles.collabActionButton),
            opacity: canJoin ? 1 : 0.5,
            cursor: canJoin ? "pointer" : "not-allowed",
          }}
          disabled={!canJoin}
          title={
            !canJoin
              ? "Subscription required to join collaborative matches"
              : canJoinAsNonPremium
              ? "You have player assignments in this match"
              : ""
          }
        >
          <div style={styles.iosActionInner}>
            {isOwner ? <PlayIcon size={16} /> : <CollaborateIcon size={16} />}
            <span>{isOwner ? "Resume" : "Join Match"}</span>
            {!hasPremium && !isOwner && !hasAssignment && <LockIcon size={13} />}
          </div>
        </button>
      )}

      {!hasCollaborativeMode && isOwner && (
        <button
          onClick={() => handleResumeButton(match)}
          style={{ ...styles.iosActionButton, ...styles.resumeActionButton }}
        >
          <div style={styles.iosActionInner}>
            <PlayIcon size={16} />
            <span>Resume</span>
          </div>
        </button>
      )}

      {isOwner && (
        <button
          onClick={() => handleEditMatch(match)}
          style={{ ...styles.iosActionButton, ...styles.secondaryActionButton }}
          title="Edit match settings"
        >
          <div style={styles.iosActionInner}>
            <EditIcon size={16} color="#374151" />
            <span>Edit</span>
          </div>
        </button>
      )}
    </>
  )}

  {isOwner && (
    <button
      onClick={() => handleDeleteMatch(match._id)}
      style={{ ...styles.iosActionButton, ...styles.destructiveActionButton }}
    >
      <div style={styles.iosActionInner}>
        <DeleteIcon size={16} color="#dc2626" />
        <span>Delete</span>
      </div>
    </button>
  )}
</div>
    );
  };

  const handleTeamSelect = async (teamName) => {
    setSelectedTeam(teamName);
    setMatchSettings((prev) => ({ ...prev, teamName: teamName }));
    await handleRecallBench(teamName);
  };

  const handleLiberoToggle = async (playerId) => {
    const player = benchPlayers.find((p) => p._id === playerId);
    if (!player) return;

    const newLiberoStatus = !player.isLibero;

    setBenchPlayers((prevPlayers) =>
      prevPlayers.map((player) =>
        player._id === playerId ? { ...player, isLibero: newLiberoStatus } : player
      )
    );

    try {
 await axios.put(
  `${API_URL}/api/players/${playerId}`, 
  {
    isLibero: newLiberoStatus,
  },
  { headers: { Authorization: `Bearer ${token}` } }
);
    } catch (err) {
      console.error("Failed to update libero status:", err);
      setBenchPlayers((prevPlayers) =>
        prevPlayers.map((player) =>
          player._id === playerId ? { ...player, isLibero: !player.isLibero } : player
        )
      );
      alert("Failed to update libero status. Please try again.");
    }
  };

  const handleFindPlayerOnTeams = (playerName) => {
    setSearchPlayerName(playerName);
    setShowExternalSearch(true);
  };

  const handleCloseExternalSearch = () => {
    setShowExternalSearch(false);
    setSearchPlayerName('');
  };

  // Helper function to validate roster before starting match
  const validateRosteredTeam = () => {
    if (!selectedTeam) {
      alert("Please select a team before starting a match.");
      return false;
    }
    
    if (!benchPlayers || benchPlayers.length === 0) {
      alert("Please add players to your roster before starting a match. A rostered team is required.");
      return false;
    }
    
    return true;
  };

  const handleSaveAndStartMatchTracking = async () => {
    if (!validateRosteredTeam()) return;
    
    const updatedSettings = {
      ...matchSettings,
      opponentName,
      totalSets: maxSets, 
      playAllSets,
      eventName,
      location,
      pointsNonDeciding,
      pointsDeciding,
      teamName: selectedTeam,
	  mode: 'match',
    };

    setMatchSettings(updatedSettings);

    setTimeout(async () => {
      await handleNewMatch(updatedSettings);
      
      setToastVisible(true);

      setTimeout(() => {
        setToastVisible(false);
        navigate("/match-tracking");
      }, 1000);
    }, 100); 
  };

  const handleSaveAndStartMatch = async () => {
    if (!validateRosteredTeam()) return;
    
    const updatedSettings = {
      ...matchSettings,
      opponentName,
      totalSets: maxSets, 
      playAllSets,
      eventName,
      location,
      pointsNonDeciding,
      pointsDeciding,
      teamName: selectedTeam,
	  mode: 'classic',
    };

    setMatchSettings(updatedSettings);

    setTimeout(async () => {
      await handleNewMatch(updatedSettings);
      
      setToastVisible(true);

      setTimeout(() => {
        setToastVisible(false);
        navigate("/classic");
      }, 1000);
    }, 100); 
  };

  const handleExpressMatch = async () => {
    if (!validateRosteredTeam()) return;
    
    const updatedSettings = {
      ...matchSettings,
      opponentName,
      totalSets: maxSets, 
      playAllSets,
      eventName,
      location,
      pointsNonDeciding,
      pointsDeciding,
      teamName: selectedTeam,
	  mode: 'statbook',
      collaborativeMode: { 
        enabled: false,
        allowedUsers: [], 
        maxUsers: 1
      }
    };

    setMatchSettings(updatedSettings);

    setTimeout(async () => {
      await handleNewMatch(updatedSettings);
      
      setToastVisible(true);

      setTimeout(() => {
        setToastVisible(false);
        navigate("/stat-book");
      }, 1000);
    }, 100); 
  };

  const handleCollabMatch = async () => {
    if (!validateRosteredTeam()) return;
    
    const updatedSettings = {
      ...matchSettings,
      opponentName,
      totalSets: maxSets, 
      playAllSets,
      eventName,
      location,
      pointsNonDeciding,
      pointsDeciding,
      teamName: selectedTeam,
	  mode: 'collab',
      collaborativeMode: { 
        enabled: true,
        allowedUsers: [], 
        maxUsers: 15
      }
    };

    setMatchSettings(updatedSettings);

    setTimeout(async () => {
      await handleNewMatch(updatedSettings);
      
      setToastVisible(true);

      setTimeout(() => {
        setToastVisible(false);
        navigate("/stat-book");
      }, 1000);
    }, 100); 
  };

  const handleResumeMatch = async (match) => {
   try {
    if (!match) {
      alert("No match data provided.");
      return;
    }

    const isOwner = String(match.userId) === String(user.id || user._id);
    const hasTeamAccess = user.teams && user.teams.includes(match.teamName);
    const canAccessMatch = isOwner || hasTeamAccess;

    if (!canAccessMatch) {
      console.error(`SECURITY: User ${user.id} cannot access match ${match._id}`);
      alert("Access denied: You don't have permission to view this match.");
      return;
    }

    setCurrentMatchId(match._id);
    
    try {
      await axios.put(`${API_URL}/api/users/${user.id}/match-id`, {
        currentMatchId: match._id
      }, {
        headers: { Authorization: `Bearer ${token}` }
      });
    } catch (err) {
      console.error("Failed to update currentMatchId", err);
    }
    
    // ✅ NEW: Navigate based on match mode
    const mode = (match.mode || "Gameflow").toLowerCase();
    console.log(`📍 RESUME MATCH - match.mode from DB:`, match.mode, "normalized to:", mode);
    setTimeout(() => {
      console.log(`📍 Navigating to correct mode: ${mode}`);
      if (mode === "statbook") {
        navigate("/stat-book", { replace: true });
      } else if (mode === "collab") {
        navigate("/stat-book?collab=true", { replace: true });
      } else if (mode === "gameflow" || mode === "classic") {
        navigate("/classic", { replace: true });
      } else {
        navigate("/match-tracking", { replace: true });
      }
    }, 100);
    
  } catch (err) {
    console.error("Error during match resume:", err);
    alert("Failed to resume the match. Please try again.");
  }
};

const handleStartScheduledMatch = async (match, mode) => {
  if (!validateRosteredTeam()) return;
  
  try {
    const res = await axios.put(
      `${API_URL}/api/matches/start/${match._id}`,
      { mode },
      { headers: { Authorization: `Bearer ${token}` } }
    );

    const updated = res.data;

    // ✅ IMPORTANT: await resume so currentMatchId is set BEFORE leaving settings
    await handleResumeMatch(updated);

    // ✅ IMPORTANT: wipe in-memory UI state so Express starts clean
    if (typeof resetMatchStateOnly === "function") {
      resetMatchStateOnly();
    }

    // Now go to the right mode
    if (mode === "classic") navigate("/classic", { replace: true });
    if (mode === "statbook") navigate("/stat-book", { replace: true });
    if (mode === "collab") navigate("/stat-book?collab=true", { replace: true });
    if (mode === "match") navigate("/match-tracking", { replace: true });

  } catch (err) {
    console.error("Failed to start scheduled match", err);
    alert("Could not start scheduled match.");
  }
};

const handleScheduleMatch = async () => {
  if (!selectedTeam) {
    alert("Select a team before scheduling a match.");
    return;
  }

  if (!scheduleDate) {
    alert("Pick a match date.");
    return;
  }

  // Build scheduled datetime (needs the "T")
  const when = new Date(`${scheduleDate}T${scheduleTime || "09:00"}:00`);
  
  // --- prevent duplicate scheduled match: same team + opponent + date/time ---
const normalizeOpponent = (s) => (s || "").trim().toLowerCase();
const opponentKey = normalizeOpponent(opponentName || "Opponent");

// use epoch minutes to avoid ms/seconds differences
const whenKey = Math.floor(when.getTime() / 60000);

const isDup = (scheduledMatches || []).some((m) => {
  const mOpponentKey = normalizeOpponent(m.opponentName);
  const mWhen = m.scheduledFor ? new Date(m.scheduledFor) : null;
  const mWhenKey = mWhen ? Math.floor(mWhen.getTime() / 60000) : null;

  return (
    (m.teamName || "") === (selectedTeam || "") &&
    mOpponentKey === opponentKey &&
    mWhenKey === whenKey
  );
});

if (isDup) {
  alert("That match is already scheduled for the same opponent at that time.");
  return;
}


  const payload = {
    userId: user?.id || user?._id,
    userEmail: user?.email || user?.userEmail || "",
    userDisplayName:
      user?.displayName ||
      user?.name ||
      user?.fullName ||
      ((user?.firstName || user?.lastName)
        ? `${user?.firstName || ""} ${user?.lastName || ""}`.trim()
        : ""),

    teamName: selectedTeam,
    opponentName: opponentName || "Opponent",
    eventName,
    location,
    currentSet: 1,
    totalSets: maxSets,
    playAllSets,
    pointsNonDeciding,
    pointsDeciding,
    ourScore: 0,
    opponentScore: 0,
    courtPlayers: [],
    benchPlayers: [],
    substitutionLog: [],
    actionLog: [],
    liberoSubTargets: { allowedLiberoSubTarget: null, slot5TargetId: null },

    status: "Scheduled",
    isScheduled: true,
    scheduledFor: when,
  };

  try {
    const res = await axios.post(
      `${API_URL}/api/matches/save`,
      payload,
      { headers: { Authorization: `Bearer ${token}` } }
    );

    const created = res.data;

    const createdWithOwner = {
      ...created,
      userId: created.userId || payload.userId,
      userDisplayName:
        created.userDisplayName ||
        payload.userDisplayName ||
        user?.displayName ||
        user?.name ||
        "",
      userEmail:
        created.userEmail ||
        payload.userEmail ||
        user?.email ||
        "",
    };

    setScheduledMatches((prev) => [createdWithOwner, ...prev]);

    setScheduleDate("");
    setScheduleTime("");

    alert("Match scheduled!");
  } catch (err) {
    console.error("Failed to schedule match:", err);
    alert("Could not schedule match. Please try again.");
  }
};


  const handleCollaborativeJoin = async (match) => {
    try {
      setIsRestoring(true);
      
      const isOwner = match.userId === user?.id;
      console.log(`${isOwner ? 'Resuming' : 'Joining'} collaborative match ${match._id}`);
      
      // CRITICAL: Update currentMatchId in database FIRST, before any navigation
      try {
        await axios.put(`${API_URL}/api/users/${user.id}/match-id`, {
          currentMatchId: match._id
        }, {
          headers: { Authorization: `Bearer ${token}` },
          withCredentials: true
        });
        console.log(`✅ Database updated: currentMatchId set to ${match._id}`);
        
        // Update local state
        setCurrentMatchId(match._id);
        console.log(`✅ Local state updated: currentMatchId set to ${match._id}`);
        
      } catch (err) {
        console.error("Failed to set collaborative match as currentMatchId", err);
        throw new Error("Failed to update match ID. Please try again.");
      }
      
      // Now resume the match (this will load match data and set up state)
      await handleResumeMatch(match);
      
      // Navigate to the appropriate mode based on match.mode
      // handleResumeMatch already navigates, so we don't need to do it again
      console.log(`✅ Successfully joined collaborative match ${match._id}`);
      
    } catch (error) {
      const isOwner = match.userId === user?.id;
      console.error(`Failed to ${isOwner ? 'resume' : 'join'} collaborative match:`, error);
      alert(`Error ${isOwner ? 'resuming' : 'joining'} collaborative match. Please try again.`);
    } finally {
      setIsRestoring(false);
    }
  };

  const renderEditModal = () => {
    if (!editingMatch) return null;
    
    return (
      <div style={styles.modalOverlay} onClick={() => setEditingMatch(null)}>
        <div style={styles.modalContent} onClick={(e) => e.stopPropagation()}>
          <h2 style={styles.modalTitle}>Edit Match Settings</h2>
          
          <div style={styles.editForm}>
            <div style={styles.formField}>
              <label style={styles.formLabel}>Opponent</label>
              <input
                type="text"
                value={editFormData.opponentName}
                onChange={(e) => setEditFormData(prev => ({ ...prev, opponentName: e.target.value }))}
                style={styles.formInput}
              />
            </div>
            
            <div style={styles.formField}>
              <label style={styles.formLabel}>Event</label>
              <input
                type="text"
                value={editFormData.eventName}
                onChange={(e) => setEditFormData(prev => ({ ...prev, eventName: e.target.value }))}
                style={styles.formInput}
              />
            </div>
            
            <div style={styles.formField}>
              <label style={styles.formLabel}>Location</label>
              <input
                type="text"
                value={editFormData.location}
                onChange={(e) => setEditFormData(prev => ({ ...prev, location: e.target.value }))}
                style={styles.formInput}
              />
            </div>
            
            <div style={styles.formField}>
              <label style={styles.formLabel}>Max Sets</label>
              <input
                type="number"
                value={editFormData.totalSets}
                onChange={(e) => setEditFormData(prev => ({ ...prev, totalSets: parseInt(e.target.value) || 0 }))}
                style={styles.formInput}
                min="1"
                max="5"
              />
            </div>
            
            <div style={styles.formField}>
              <label style={styles.checkboxLabel}>
                <input
                  type="checkbox"
                  checked={editFormData.playAllSets}
                  onChange={(e) => setEditFormData(prev => ({ ...prev, playAllSets: e.target.checked }))}
                  style={{ marginRight: '8px' }}
                />
                Play all sets regardless of outcome
              </label>
            </div>
            
            <div style={styles.formField}>
              <label style={styles.formLabel}>Points per Set</label>
              <input
                type="number"
                value={editFormData.pointsNonDeciding}
                onChange={(e) => setEditFormData(prev => ({ ...prev, pointsNonDeciding: parseInt(e.target.value) || 0 }))}
                style={styles.formInput}
                min="1"
              />
            </div>
            
            <div style={styles.formField}>
              <label style={styles.formLabel}>Deciding Set Points</label>
              <input
                type="number"
                value={editFormData.pointsDeciding}
                onChange={(e) => setEditFormData(prev => ({ ...prev, pointsDeciding: parseInt(e.target.value) || 0 }))}
                style={styles.formInput}
                min="1"
              />
            </div>
          </div>
          
          <div style={styles.modalActions}>
            <button onClick={() => setEditingMatch(null)} style={styles.cancelButton}>
              Cancel
            </button>
            <button onClick={handleSaveEditedMatch} style={styles.saveButton}>
              Save Changes
            </button>
          </div>
        </div>
      </div>
    );
  };

  // NEW: Render player edit modal
  const renderPlayerEditModal = () => {
    if (!editingPlayer) return null;
    
    return (
      <div style={styles.modalOverlay} onClick={() => setEditingPlayer(null)}>
        <div style={styles.modalContent} onClick={(e) => e.stopPropagation()}>
          <h2 style={styles.modalTitle}>Edit Player</h2>
          
          <div style={styles.editForm}>
            <div style={styles.formField}>
              <label style={styles.formLabel}>Name</label>
              <input
                type="text"
                value={playerEditFormData.name}
                onChange={(e) => setPlayerEditFormData(prev => ({ ...prev, name: e.target.value }))}
                style={styles.formInput}
                placeholder="Player name"
              />
            </div>
            
            <div style={styles.formField}>
              <label style={styles.formLabel}>Number</label>
              <input
                type="number"
                value={playerEditFormData.number}
                onChange={(e) => setPlayerEditFormData(prev => ({ ...prev, number: e.target.value }))}
                style={styles.formInput}
                min="0"
                placeholder="Jersey number"
              />
            </div>
            
            <div style={styles.formField}>
              <label style={styles.formLabel}>Position</label>
              <select
                value={playerEditFormData.position}
                onChange={(e) => setPlayerEditFormData(prev => ({ ...prev, position: e.target.value }))}
                style={styles.formInput}
              >
                <option value="">Select Position</option>
                <option value="OH">OH (Outside Hitter)</option>
                <option value="MB">MB (Middle Blocker)</option>
                <option value="S">S (Setter)</option>
                <option value="OPP">OPP (Opposite)</option>
                <option value="DS">DS (Defensive Specialist)</option>
              </select>
            </div>
            
            <div style={styles.formField}>
              <label style={styles.checkboxLabel}>
                <input
                  type="checkbox"
                  checked={playerEditFormData.isLibero}
                  onChange={(e) => setPlayerEditFormData(prev => ({ ...prev, isLibero: e.target.checked }))}
                  style={{ marginRight: '8px' }}
                />
                Libero
              </label>
            </div>
          </div>
          
          <div style={styles.modalActions}>
            <button onClick={() => setEditingPlayer(null)} style={styles.cancelButton}>
              Cancel
            </button>
            <button onClick={handleSaveEditedPlayer} style={styles.saveButton}>
              Save Changes
            </button>
          </div>
        </div>
      </div>
    );
  };

  const handleDeleteMatch = async (matchId) => {
    if (!window.confirm("Delete this match permanently?")) return;
    try {
      await axios.delete(
  `${API_URL}/api/matches/delete/${matchId}`,
  { headers: { Authorization: `Bearer ${token}` } }
);
	  setSavedMatches((prev) => prev.filter((m) => m._id !== matchId));
      setScheduledMatches((prev) => prev.filter((m) => m._id !== matchId));
    } catch (err) {
      console.error("Failed to delete match", err);
    }
  };

const groupByEvent = (matches) =>
  (matches || []).reduce((acc, match) => {
    const key = match.eventName?.trim() || "No Event";
    if (!acc[key]) acc[key] = [];
    acc[key].push(match);
    return acc;
  }, {});

const inProcessMatches = (savedMatches || []).filter(
  (m) => (m.status || "In Process") !== "Final"
);

const finalMatches = (savedMatches || []).filter(
  (m) => m.status === "Final"
);

const groupedInProcessByEvent = groupByEvent(inProcessMatches);
const groupedFinalByEvent = groupByEvent(finalMatches);


  const gridContainerStyle = {
    display: 'grid',
    gridTemplateColumns: isMobile && isPortrait
      ? 'repeat(2, 1fr)'
      : isMobile
      ? 'repeat(3, 1fr)'
      : 'repeat(auto-fill, minmax(200px, 1fr))',
