function App() {
  return (
   <AuthProvider>
    <CollaborativeProvider>
      <Router>
        <AppContent />
      </Router>
    </CollaborativeProvider>  
   </AuthProvider>
  );
}

function AppContent() {
  // FIXED: Add missing hooks at the top
  const { user, token } = useAuth();
