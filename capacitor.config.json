{
  "appId": "com.loggerheadstat.app",
  "appName": "Loggerhead Volleyball Stats",
  "webDir": "build",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "iosSpinnerStyle": "small",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": false
    }
  }
}

